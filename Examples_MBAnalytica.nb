Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BarnesReduce", "::", "usage"}]], "Input",ExpressionUUID->"1ae494ed-f7a8-45a3-a0fb-78a0084391c4"],

Cell[BoxData["\<\"BarnesReduce is an option of MBEvaluate which specifies \
whether the first and second Barnes lemmas are applied, with DoAllBarnes, to \
the expanded integral before it is solved by the SymbolicSum method. Its \
default value is True.\"\>"], "Output",ExpressionUUID->"c8604d5f-f5c4-4c81-\
855b-00ad99918aab"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "CosmoTreeMB", "]"}]], "Input",ExpressionUUID->"4e72466d-baea-446e-a66c-5ebfadc97406"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Energies\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"Point\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"KLegs\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"Orientations\"\>", "\[Rule]", "All"}], ",", 
   RowBox[{"\<\"VariableName\"\>", "\[Rule]", "\<\"u\"\>"}], ",", 
