Cell["\<\
The coefficients agree with a direct numerical integration of the Bessel time \
integral at small values of \[Delta] (Section 6.5 of the paper).\
\>", "Text",ExpressionUUID->"f66baaf9-a379-4f23-941f-80d592863ff2"],

Cell["\<\
The full expansion of A for the light field, from the thirty MB integrals of \
the light split, is distributed with the package in \
examples/DoubleExchangeLight.m. Its two leading coefficients are free of MPLs:\
\>", "Text",ExpressionUUID->"44ae150b-0565-41b2-8010-8263480a99c3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dexL", " ", "=", " ", 
   RowBox[{"Get", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "$MBAnalyticaDirectory", ",", " ", "\"\<examples\>\"", ",", 
       " ", "\"\<DoubleExchangeLight.m\>\""}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dexL", "[", 
      RowBox[{"-", "3"}], "]"}], ",", " ", 
     RowBox[{"dexL", "[", 
      RowBox[{"-", "2"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"k1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"k2", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"k3", " ", ">", " ", "0"}]}]}], "]"}]}], "Input",ExpressionUUID->\
"d3d1396c-35d7-431d-9e6c-d80baa88a93d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    FractionBox["k2", 
     RowBox[{
      SuperscriptBox["k1", "2"], " ", 
      SuperscriptBox["k3", "2"]}]]}], ",", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["k1", "2"], "-", 
           SuperscriptBox["k2", "2"], "+", 
