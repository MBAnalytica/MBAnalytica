Cell[CellGroupData[{

Cell["Angular Phase-Space Integrals", "Chapter",ExpressionUUID->"6929b173-a5f1-4b5f-a0c2-8f24742b0e6e"],

Cell["\<\
The angular integrals of Section 6.2 of the paper, with all powers j_k = 1 \
and the normalisation I = 2^(-1 + 2 \[Epsilon]) \[Pi]^\[Epsilon] \
\[CapitalGamma](1 - 2 \[Epsilon])/\[CapitalGamma](1 - \[Epsilon]) \
\[CapitalOmega]. Every variable v_kl is a kinematic variable in 0 < v_kl < 1, \
and the integral has one fold per variable.\
\>", "Text",ExpressionUUID->"cce9cfcc-b9bd-4a9a-af73-39d668a95815"],

Cell[CellGroupData[{

Cell["Two Massless Denominators (Fold = 1)", "Section",ExpressionUUID->"2e690705-1c1d-453c-bed0-ad43a6dca177"],

Cell[BoxData[
 RowBox[{
  RowBox[{"I11", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "+", " ", 
       RowBox[{"2", " ", "\[Epsilon]"}]}], ")"}]}], " ", 
    RowBox[{"Pi", "^", "\[Epsilon]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "-", " ", "\[Epsilon]"}], "]"}]}], " ", 
    RowBox[{"2", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[Epsilon]"}], ")"}]}], " ", 
    RowBox[{
     RowBox[{"Pi", "^", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "\[Epsilon]"}], ")"}]}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[Epsilon]"}], "]"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z12"}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "+", " ", "z12"}], "]"}], "^", "2"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "-", " ", "\[Epsilon]", " ", "-", " ", "z12"}],
      "]"}], " ", 
    RowBox[{"v12", "^", "z12"}]}]}], ";"}]], "Input",ExpressionUUID->\
"ea021d21-ccc9-48da-8e14-514654644804"],

Cell[CellGroupData[{

