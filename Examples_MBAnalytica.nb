          RowBox[{"-", "1"}], "+", "u"}]], ",", "1"}], "]"}]}], "-", 
     RowBox[{"6", " ", 
      RowBox[{"G", "[", 
       RowBox[{"0", ",", 
        FractionBox["1", 
         RowBox[{"1", "-", "u"}]], ",", "1"}], "]"}]}], "+", 
     RowBox[{"12", " ", 
