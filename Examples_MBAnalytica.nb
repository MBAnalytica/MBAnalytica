          FractionBox[
           RowBox[{"2", " ", "k3"}], 
           RowBox[{"k1", "+", "k2", "+", "k3"}]], "]"}]}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["k1", "2"], " ", 
        SuperscriptBox["k3", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"k1", "+", "k2", "+", "k3"}], ")"}]}], ")"}]}], ")"}]}]}], 
  "}"}]], "Output",ExpressionUUID->"48b1b998-16d4-4f9f-94d3-608e7ce6b2fa"]
}, Open  ]],

