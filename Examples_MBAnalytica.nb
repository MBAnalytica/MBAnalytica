Cell[CellGroupData[{

Cell["Exchange of a Scalar of Nearly Conformal Mass", "Section",ExpressionUUID->"a11955ff-f31b-465e-8b1f-354874662223"],

Cell["\<\
The two-site exchange of a scalar of mass m^2 = (9/4 - \[Nu]^2) H^2 in de \
Sitter space with \[Nu] = 1/2 - \[Delta]; the regulator \[Epsilon] stands for \
\[Delta]. Each orientation gives a three-fold MB integral.\
\>", "Text",ExpressionUUID->"1be0b80c-2fc0-4817-9e91-6e4d46f50016"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tc2", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "-", " ", "\[Epsilon]"}], "}"}], ",", 
     " ", 
     RowBox[{"\"\<Energies\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"X1", ",", " ", "X2"}], "}"}], ",", " ", 
        RowBox[{"{", "Y", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<Point\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"3", "/", "2"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", "/", "3"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",\
ExpressionUUID->"ae1992f6-6274-4c4d-95a8-21b4e3cfa12a"],

