   RowBox[{"\<\"PushChoice\"\>", "\[Rule]", "1"}]}], "}"}]], "Output",Expressi\
onUUID->"60ba9ee5-f9c4-4d8e-8192-75ba75d99988"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Numerical Evaluation of Multiple Polylogarithms", "Section",ExpressionUUID->"af9d3f98-5396-47af-b004-402a1ac85578"],

Cell["\<\
The results are given in terms of the multiple polylogarithms G of \
PolyLogTools, together with logarithms, classical polylogarithms and zeta \
values. Their numerical values at a kinematic point follow from the interface \
of PolyLogTools to GiNaC, which MBAnalytica configures once an integration \
method (ExpandInt or Subtraction) has run. We use it through the following \
function.\
\>", "Text",ExpressionUUID->"cec2c10d-0208-47c9-acdd-95c384e3fc54"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NG", "[", 
   RowBox[{"expr_", ",", " ", "point_List"}], "]"}], " ", ":=", " ", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"$ContextPath", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<PolyLogTools`\>\"", ",", " ", "\"\<System`\>\""}], 
       "}"}]}], "}"}], ",", " ", 
    RowBox[{"PolyLogTools`Ginsh", "[", 
     RowBox[{
      RowBox[{"expr", " ", "/.", " ", "point"}], ",", " ", 
      RowBox[{"{", "}"}]}], "]"}]}], "]"}]}]], "Input",ExpressionUUID->\
"aabdecfb-3c79-400e-8299-e09d416db0fd"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Mellin\[Dash]Barnes Integral with Fold = 1", "Chapter",ExpressionUUID->"11aead32-a963-48e4-bdb9-1c9a50c68fbf"],

Cell["\<\
The one-fold integral of the installation test, Section 5.4 of the paper. As \
\[Epsilon] \[Rule] 0, the poles of Gamma[z + \[Epsilon]] and Gamma[-z] pinch \
the contour, and together with the prefactor Gamma[\[Epsilon]] the \
continuation produces a pole of third order. The integrand is entered as it \
stands.\
\>", "Text",ExpressionUUID->"457cf28e-99c5-41b4-9c92-4dfeb57f7587"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MB1", " ", "=", " ", 
   RowBox[{
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"EulerGamma", " ", "+", " ", 
         RowBox[{"I", " ", "Pi"}]}], ")"}], " ", "\[Epsilon]"}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", "\[Epsilon]", "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"2", " ", "-", " ", 
      RowBox[{"4", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"4", " ", "-", " ", 
       RowBox[{"4", " ", "\[Epsilon]"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"2", " ", "-", " ", 
         RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"4", " ", "-", " ", 
         RowBox[{"8", " ", "\[Epsilon]"}]}], "]"}]}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "-", " ", "z", " ", "-", " ", 
      RowBox[{"3", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z", " ", "-", " ", "\[Epsilon]"}], "]"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"z", " ", "+", " ", "\[Epsilon]"}], "]"}], "^", "2"}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{"2", " ", "+", " ", "z", " ", "-", " ", 
       RowBox[{"3", " ", "\[Epsilon]"}]}], "]"}]}]}]}], ";"}]], "Input",Expres\
sionUUID->"24c29903-3a8b-4238-83c1-746c7fc202e9"],

Cell[CellGroupData[{

Cell["Default Method", "Section",ExpressionUUID->"e6222ce6-aea9-477a-8182-ba4c28c1a6d1"],

Cell["\<\
With the default Method -> Automatic, the methods available on the machine \
are tried in the order SymbolicSum, ExpandInt, Subtraction, each one only on \
the orders the earlier ones left open.\
\>", "Text",ExpressionUUID->"82b18f60-5cf5-4311-9bc6-160d1b2bb299"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MBEvaluate", "[", 
  RowBox[{"MB1", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Epsilon]", ",", " ", "0"}], "}"}]}], "]"}]], "Input",Expression\
UUID->"24ba0d67-5f5c-49ea-bbbb-051b3583ef3d"],

Cell[BoxData[
 RowBox[{
  FractionBox["13600", "27"], "-", 
  FractionBox[
   RowBox[{"647", " ", 
    SuperscriptBox["\[Pi]", "2"]}], "18"], "+", 
  FractionBox["1", 
   SuperscriptBox["\[Epsilon]", "3"]], "+", 
  FractionBox["25", 
   RowBox[{"3", " ", 
    SuperscriptBox["\[Epsilon]", "2"]}]], "+", 
  FractionBox[
   RowBox[{
    FractionBox["584", "9"], "-", 
    FractionBox[
     RowBox[{"13", " ", 
      SuperscriptBox["\[Pi]", "2"]}], "3"]}], "\[Epsilon]"], "-", 
  FractionBox[
   RowBox[{"380", " ", 
    RowBox[{"Zeta", "[", "3", "]"}]}], "3"]}]], "Output",ExpressionUUID->\
"108c94eb-2dd5-4e47-843f-48c842c2e911"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["SymbolicSum", "Section",ExpressionUUID->"c7aef735-dfe3-47f1-a929-2cd222815e91"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resSymbolicSum", " ", "=", " ", 
  RowBox[{"MBEvaluate", "[", 
   RowBox[{"MB1", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", ",", " ", "0"}], "}"}], ",", " ", 
    RowBox[{"Method", " ", "->", " ", "\"\<SymbolicSum\>\""}]}], 
   "]"}]}]], "Input",ExpressionUUID->"bcc26afc-3753-4ea2-886b-3cbdf15defa9"],

Cell[BoxData[
 RowBox[{
  FractionBox["13600", "27"], "-", 
  FractionBox[
   RowBox[{"647", " ", 
    SuperscriptBox["\[Pi]", "2"]}], "18"], "+", 
  FractionBox["1", 
   SuperscriptBox["\[Epsilon]", "3"]], "+", 
  FractionBox["25", 
   RowBox[{"3", " ", 
    SuperscriptBox["\[Epsilon]", "2"]}]], "+", 
  FractionBox[
   RowBox[{
    FractionBox["584", "9"], "-", 
    FractionBox[
     RowBox[{"13", " ", 
      SuperscriptBox["\[Pi]", "2"]}], "3"]}], "\[Epsilon]"], "-", 
  FractionBox[
   RowBox[{"380", " ", 
    RowBox[{"Zeta", "[", "3", "]"}]}], "3"]}]], "Output",ExpressionUUID->\
"b5b7afa0-b0f7-44f3-9e8a-c40f3e894eab"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["ExpandInt", "Section",ExpressionUUID->"f35f920e-1055-4c39-9370-6991145df04e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resExpandInt", " ", "=", " ", 
  RowBox[{"MBEvaluate", "[", 
   RowBox[{"MB1", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"Method", " ", "->", " ", "\"\<ExpandInt\>\""}]}], 
   "]"}]}]], "Input",ExpressionUUID->"74470350-e8c4-4c39-8861-65016842094e"],

Cell[BoxData[
 RowBox[{
  FractionBox["13600", "27"], "-", 
  FractionBox[
   RowBox[{"647", " ", 
    SuperscriptBox["\[Pi]", "2"]}], "18"], "+", 
  FractionBox["1", 
   SuperscriptBox["\[Epsilon]", "3"]], "+", 
  FractionBox["25", 
   RowBox[{"3", " ", 
    SuperscriptBox["\[Epsilon]", "2"]}]], "+", 
  FractionBox[
   RowBox[{
    FractionBox["584", "9"], "-", 
    FractionBox[
     RowBox[{"13", " ", 
      SuperscriptBox["\[Pi]", "2"]}], "3"]}], "\[Epsilon]"], "+", 
  RowBox[{"\[Epsilon]", " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["319616", "81"], "-", 
     FractionBox[
      RowBox[{"7532", " ", 
       SuperscriptBox["\[Pi]", "2"]}], "27"], "-", 
     FractionBox[
      RowBox[{"613", " ", 
       SuperscriptBox["\[Pi]", "4"]}], "360"], "-", 
     FractionBox[
      RowBox[{"9428", " ", 
       RowBox[{"Zeta", "[", "3", "]"}]}], "9"]}], ")"}]}], "-", 
  FractionBox[
   RowBox[{"380", " ", 
    RowBox[{"Zeta", "[", "3", "]"}]}], "3"]}]], "Output",ExpressionUUID->\
"ae6075ef-9e28-44fc-8370-2d4444ed8b74"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Subtraction", "Section",ExpressionUUID->"15dfe041-a86d-49a7-898d-a71359ff0bdd"],

Cell["\<\
The Subtraction method reaches \[Epsilon]^5, where the coefficient is of \
weight up to eight. Besides products of zeta values, it contains the \
irreducible constant of weight eight HPLs8a of the HPL package, which \
corresponds to the multiple zeta value \[Zeta](5,3).\
\>", "Text",ExpressionUUID->"329b7059-8861-4a83-be71-d4d5aea1fe69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resSubtraction", " ", "=", " ", 
  RowBox[{"MBEvaluate", "[", 
   RowBox[{"MB1", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", ",", " ", "5"}], "}"}], ",", " ", 
