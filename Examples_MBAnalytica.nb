       RowBox[{"0", ",", 
        FractionBox["1", "u"], ",", "1"}], "]"}]}], "-", 
     RowBox[{"9", " ", 
      SuperscriptBox[
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", "u"}], "]"}], "2"]}], "+", 
