Cell[CellGroupData[{

Cell["External Commands", "Section",ExpressionUUID->"22e36274-1990-451f-a5a1-64fcdc138061"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MBEvaluate", "::", "usage"}]], "Input",ExpressionUUID->"a1801243-25c6-4578-b5ea-12302ca6dd32"],

Cell[BoxData["\<\"MBEvaluate[MBInt, {Eps, Ord}] returns the expansion of the \
Mellin-Barnes integral MBInt in Eps, from its leading pole through the order \
Eps^Ord, in terms of multiple polylogarithms G, Log, Zeta and Pi.\\n\\nMBInt  \
- the MB integrand, built from Gamma and PolyGamma functions and powers of \
the kinematic variables\\nEps    - the dimensional regulator appearing in \
MBInt\\nOrd    - the deepest order of Eps to be evaluated\\n\\nThe \
integration variables are the variables inside the Gamma and PolyGamma \
functions and the kinematic variables are whatever is left, so neither has to \
be given. MBEvaluate[MBInt, MBVar, {Eps, Ord}] names the kinematic variables \
explicitly; they are taken in 0 < x < 1.\\n\\nA coefficient that could not be \
brought to a closed form is returned as MBFailed[reasons].\\n\\nOptions:\\n  \
Method -> Automatic       tries the methods available on this machine in the \
order \\\"SymbolicSum\\\", \\\"ExpandInt\\\", \\\"Subtraction\\\", each one \
only on the orders the earlier ones left open; \\\"SymbolicSum\\\", \
\\\"ExpandInt\\\" or \\\"Subtraction\\\" uses that method alone (\\\"HyperLog\
\\\" and \\\"Standard\\\" are accepted as aliases of \\\"ExpandInt\\\", and \
\\\"Resum\\\" of \\\"SymbolicSum\\\")\\n  Verbose -> False          prints \
one line per stage\\n  BarnesReduce -> True      applies the Barnes lemmas \
before the SymbolicSum method solves the integral\\n  Complex -> False        \
  returns the real part; True returns the full complex \
value\\n\\nExamples:\\n  MBEvaluate[MB1, {\[Epsilon], 0}]\\n  MBEvaluate[MB1, \
{\[Epsilon], 0}, Method -> \\\"ExpandInt\\\"]\\n  MBEvaluate[MB1u, \
{\[Epsilon], -1}, Complex -> True]\"\>"], "Output",ExpressionUUID->"d123bdb0-\
7366-4c08-aa25-36a8bf5c8996"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CosmoTreeMB", "::", "usage"}]], "Input",ExpressionUUID->"3f6ca429-925a-49b8-b59d-4a5b3534b8b3"],

Cell[BoxData["\<\"CosmoTreeMB[lines, r, nu] gives balanced unit-slope MB \
integrals, one per orientation of the lines, for the de Sitter tree time \
integral Int prod_v dt_v t_v^(r_v - 1) Exp[-x_v t_v] prod_l BesselK[nu_l, y_l \
t>] BesselI[nu_l, y_l t<]. lines lists the vertex pairs {v, w} of a tree on \
the vertices 1, ..., Length[r]; nu lists the Bessel orders. Each result is an \
association: \\\"Integrand\\\" (the MB, for MBEvaluate), \\\"Variables\\\" \
(the MB variables in the energies), \\\"Prefactor\\\", \\\"Later\\\" (the \
later vertex of each line), \\\"Push\\\" and \\\"Base\\\"; the integral is \
the sum over the orientations of Prefactor times the integrand's value. \
Options: \\\"Energies\\\" -> {{x1, ...}, {y1, ...}}, \\\"Point\\\" -> numeric \
energies (needed to choose positive rewritings), \\\"KLegs\\\" -> {{v, \
energy, nu}, ...} (factors BesselK[nu, energy t_v] of an in-in block), \
\\\"Orientations\\\" and \\\"VariableName\\\".\"\>"], "Output",ExpressionUUID->\
"b37c2440-af97-42ac-9410-54857667e867"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MBFailed", "::", "usage"}]], "Input",ExpressionUUID->"217830fc-f264-44f9-b056-609e7a19fce7"],

Cell[BoxData["\<\"MBFailed[reasons] stands for a coefficient that no method \
could bring to a closed form; reasons names what was left unresolved.\"\>"], \
"Output",ExpressionUUID->"67489a4c-a5c7-466d-a2bf-703ff5c4cd33"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MBAnalyticaCheck", "::", "usage"}]], "Input",ExpressionUUID->"b74c45a9-a111-43f5-8aa2-c7faf51406cf"],

Cell[BoxData["\<\"MBAnalyticaCheck[] prints which dependencies of MBAnalytica \
were found on this machine, what to do about each missing one, and which \
methods can run. It returns an association with the same information.\"\>"], \
"Output",ExpressionUUID->"7f9c5541-c7f9-483d-a05b-97f0fab39560"]
}, Open  ]]
}, Closed]],

