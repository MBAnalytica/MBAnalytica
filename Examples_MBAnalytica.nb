Cell[CellGroupData[{

Cell["Hypergeometric Functions", "Chapter",ExpressionUUID->"5e9765eb-2074-4679-975f-719a12d7a307"],

Cell["\<\
The Gauss function and a function of three variables from their MB \
representations, Section 6.1 of the paper. For 2F1(1, \[Epsilon]; 1 - \
\[Epsilon]; x), the kinematic variable of the MB integral is y = 1 - x.\
\>", "Text",ExpressionUUID->"7e1eab1f-5929-4c93-b3a8-29bb4097963a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F21", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "-", " ", "\[Epsilon]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Gamma", "[", "\[Epsilon]", "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"-", "\[Epsilon]"}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}]}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"\[Epsilon]", " ", "+", " ", "z"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[Epsilon]"}], " ", "-", " ", "z"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z"}], "]"}], " ", 
    RowBox[{"y", "^", "z"}]}]}], ";"}]], "Input",ExpressionUUID->"de6c9013-\
0abb-4817-b54a-6ace958af62d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resF21", " ", "=", " ", 
  RowBox[{"MBEvaluate", "[", 
   RowBox[{"F21", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"Method", " ", "->", " ", "\"\<SymbolicSum\>\""}]}], 
   "]"}]}]], "Input",ExpressionUUID->"27274b93-44a0-4aed-a9e4-558a9708c269"],

Cell[BoxData[
 RowBox[{"1", "-", 
  RowBox[{"\[Epsilon]", " ", 
   RowBox[{"Log", "[", "y", "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[Epsilon]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[Pi]", "2"], "6"], "+", 
     RowBox[{"G", "[", 
      RowBox[{"0", ",", "1", ",", "y"}], "]"}], "-", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "y"}], "]"}], " ", 
      RowBox[{"Log", "[", "y", "]"}]}], "+", 
     SuperscriptBox[
      RowBox[{"Log", "[", "y", "]"}], "2"]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[Epsilon]", "3"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"G", "[", 
       RowBox[{"0", ",", "0", ",", 
        FractionBox["1", "y"], ",", "1"}], "]"}]}], "+", 
     RowBox[{"G", "[", 
      RowBox[{"0", ",", 
       FractionBox["1", "y"], ",", 
       FractionBox["1", "y"], ",", "1"}], "]"}], "+", 
     RowBox[{"G", "[", 
      RowBox[{
       FractionBox["1", "y"], ",", "0", ",", 
       FractionBox["1", "y"], ",", "1"}], "]"}], "+", 
     RowBox[{
      FractionBox["1", "6"], " ", 
      SuperscriptBox["\[Pi]", "2"], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "y"}], "]"}]}], "-", 
     RowBox[{
      FractionBox["1", "3"], " ", 
      SuperscriptBox["\[Pi]", "2"], " ", 
      RowBox[{"Log", "[", "y", "]"}]}], "-", 
     RowBox[{
      RowBox[{"G", "[", 
       RowBox[{"0", ",", "1", ",", "y"}], "]"}], " ", 
      RowBox[{"Log", "[", "y", "]"}]}], "+", 
     RowBox[{
      RowBox[{"G", "[", 
       RowBox[{"0", ",", 
        FractionBox["1", "y"], ",", "1"}], "]"}], " ", 
      RowBox[{"Log", "[", "y", "]"}]}], "-", 
     RowBox[{
      RowBox[{"G", "[", 
       RowBox[{
        FractionBox["1", "y"], ",", 
        FractionBox["1", "y"], ",", "1"}], "]"}], " ", 
      RowBox[{"Log", "[", "y", "]"}]}], "+", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "y"}], "]"}], " ", 
      SuperscriptBox[
       RowBox[{"Log", "[", "y", "]"}], "2"]}], "-", 
     FractionBox[
      RowBox[{"2", " ", 
       SuperscriptBox[
        RowBox[{"Log", "[", "y", "]"}], "3"]}], "3"], "-", 
     RowBox[{"Zeta", "[", "3", "]"}]}], ")"}]}]}]], "Output",ExpressionUUID->\
"a86d5bf6-4c0d-46c8-8f62-d429fba7f865"]
}, Open  ]],

Cell["\<\
Through \[Epsilon]^2, the result agrees with 1 - \[Epsilon] Log[1 - x] + \
\[Epsilon]^2 (PolyLog[2, x] + Log[1 - x]^2), here at x = 1/3.\
\>", "Text",ExpressionUUID->"2231d024-bd37-4431-9b0b-42a3c28de6ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"NG", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"resF21", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"\[Epsilon]", " ", 
            RowBox[{"Log", "[", 
             RowBox[{"1", " ", "-", " ", "x"}], "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"\[Epsilon]", "^", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"PolyLog", "[", 
               RowBox[{"2", ",", " ", "x"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"1", " ", "-", " ", "x"}], "]"}], "^", "2"}]}], 
             ")"}]}]}], " ", "/.", " ", 
          RowBox[{"x", " ", "->", " ", 
           RowBox[{"1", " ", "-", " ", "y"}]}]}], ")"}]}], ",", " ", 
       "\[Epsilon]", ",", " ", "k"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"y", " ", "->", " ", 
       RowBox[{"2", "/", "3"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"e2a0c1fe-52c1-4189-a34a-3c865c0422bf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0"}], "}"}]], "Output",ExpressionUUID->\
"4ff6ed06-ce23-4bbd-9382-2f7814196fdb"]
}, Open  ]],

Cell["\<\
The function T3 of three variables, with u_i = -x_i, is a three-fold MB \
integral.\
\>", "Text",ExpressionUUID->"0de12392-612d-4055-af64-f8a845a9937f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"T3", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "+", " ", "\[Epsilon]"}], "]"}], "/", 
     RowBox[{
      RowBox[{"Gamma", "[", "\[Epsilon]", "]"}], "^", "6"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z1"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z2"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z3"}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"\[Epsilon]", " ", "+", " ", "z1"}], "]"}], "^", "2"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"\[Epsilon]", " ", "+", " ", "z2"}], "]"}], "^", "2"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"\[Epsilon]", " ", "+", " ", "z3"}], "]"}], "^", "2"}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{
      "1", " ", "+", " ", "\[Epsilon]", " ", "+", " ", "z1", " ", "+", " ", 
       "z2", " ", "+", " ", "z3"}], "]"}]}], " ", 
    RowBox[{"u1", "^", "z1"}], " ", 
    RowBox[{"u2", "^", "z2"}], " ", 
    RowBox[{"u3", "^", "z3"}]}]}], ";"}]], "Input",ExpressionUUID->"938029e6-\
1b76-4614-a7e2-e0ac6a0ca55a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resT3", " ", "=", " ", 
   RowBox[{"MBEvaluate", "[", 
    RowBox[{"T3", ",", " ", 
     RowBox[{"{", 
      RowBox[{"u1", ",", " ", "u2", ",", " ", "u3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"Method", " ", "->", " ", "\"\<SymbolicSum\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"NG", "[", 
  RowBox[{
   RowBox[{"Coefficient", "[", 
