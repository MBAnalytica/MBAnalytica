Cell[CellGroupData[{

Cell["Double Exchange near the Conformal Mass", "Section",ExpressionUUID->"4a2733ab-63d3-4f0a-9064-2a9991472ff2"],

Cell["\<\
The bispectrum generated by the double exchange of a massive scalar: the \
channel with the cubic vertex at the momentum k2 is the combination A = 2 \
\[Psi]KIKI + (2/\[Pi])(Sin[\[Pi] \[Nu]] - 1)[\[CapitalPhi]1 \[Psi]K23 + \
\[CapitalPhi]3 \[Psi]K12 + (2/\[Pi]) Sin[\[Pi] \[Nu]] \[CapitalPhi]1 \
\[CapitalPhi]3 \[Psi]KK] of four tree integrals, in which the option \
\"KLegs\" adds the factors BesselK of the cut lines. Here \[Nu] = 1/2 - \
\[Delta], and \[CapitalPhi]i = Sqrt[\[Pi]/(2 ki)] \[CapitalGamma](1/2 + \
\[Nu]) \[CapitalGamma](1/2 - \[Nu]) = Sqrt[\[Pi]/(2 ki)] \[Pi]/Cos[\[Pi] \
\[Nu]].\
\>", "Text",ExpressionUUID->"eb1bda4c-908c-4549-8471-fac6fe6519f5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nu", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", "-", " ", "\[Epsilon]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"KIKI", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", "2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"nu", ",", " ", "nu"}], "}"}], ",", " ", 
     RowBox[{"\"\<Energies\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k1", ",", " ", "k2", ",", " ", "k3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k1", ",", " ", "k3"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<Point\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"9", "/", "10"}], ",", " ", 
          RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"4", "/", "5"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K23", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", "nu", "}"}], ",", " ", 
     RowBox[{"\"\<Energies\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k2", ",", " ", "k3"}], "}"}], ",", " ", 
        RowBox[{"{", "k3", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<KLegs\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "k1", ",", " ", "nu"}], "}"}], "}"}]}], ",", 
     " ", 
     RowBox[{"\"\<Point\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"9", "/", "10"}], ",", " ", 
          RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", "/", "5"}], "}"}], ",", " ", 
        RowBox[{"{", "1", "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K12", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", "nu", "}"}], ",", " ", 
     RowBox[{"\"\<Energies\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
