Cell[CellGroupData[{

Cell["Double Exchange of a Light Field", "Section",ExpressionUUID->"ccd9ade3-e355-49fa-b7ec-a5048bf77b30"],

Cell["\<\
For a light field, \[Nu] = 3/2 - \[Delta], the Poisson integrals contain \
powers (2 + v)^(\[Nu] - 1/2) whose MB splitting admits no straight contour. \
The option \"LightSplit\" separates the integer part of the exponent by the \
binomial theorem, and CosmoTreeMB returns every term of the split as a \
separate integral. For example, the integral \[Psi]K23 through \[Delta]^2:\
\>", "Text",ExpressionUUID->"673f0efc-4ec9-49e7-9a98-a96ef27a0525"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nu", " ", "=", " ", 
   RowBox[{
    RowBox[{"3", "/", "2"}], " ", "-", " ", "\[Epsilon]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K23", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", "nu", "}"}], ",", " ", 
     RowBox[{"\"\<Energies\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k2", ",", " ", "k3"}], "}"}], ",", " ", 
        RowBox[{"{", "k3", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<KLegs\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "k1", ",", " ", "nu"}], "}"}], "}"}]}], ",", 
     " ", 
     RowBox[{"\"\<Point\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"9", "/", "10"}], ",", " ", 
          RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", "/", "5"}], "}"}], ",", " ", 
        RowBox[{"{", "1", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<LightSplit\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Length", "[", "K23", "]"}]}], "Input",ExpressionUUID->"95b9707a-\
2cac-453d-80ef-72c6db86b26f"],

Cell[BoxData["8"], "Output",ExpressionUUID->"d14c678e-ce6e-426c-b210-159d486dd999"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"psiK23", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "[", "\"\<Prefactor\>\"", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"MBEvaluate", "[", 
         RowBox[{
          RowBox[{"b", "[", "\"\<Integrand\>\"", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Subtraction\>\""}]}], "]"}], 
        " ", "/.", " ", 
        RowBox[{"b", "[", "\"\<Variables\>\"", "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "K23"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"NG", "[", 
    RowBox[{
     RowBox[{"SeriesCoefficient", "[", 
      RowBox[{"psiK23", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", ",", " ", "0", ",", " ", "k"}], "}"}]}], "]"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k1", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"k2", " ", "->", " ", 
        RowBox[{"9", "/", "10"}]}], ",", " ", 
       RowBox[{"k3", " ", "->", " ", 
        RowBox[{"4", "/", "5"}]}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], "Input",Exp\
ressionUUID->"493f98b3-0069-460d-9e55-d4fa4aa25cbc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.2364414327483088625018049597493718272823999999999999999999`39.\
