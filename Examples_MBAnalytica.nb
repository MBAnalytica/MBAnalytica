     RowBox[{"u3", " ", "->", " ", 
      RowBox[{"1", "/", "9"}]}]}], "}"}]}], "]"}]}], "Input",ExpressionUUID->\
"27f7174a-683a-423e-a6bd-f0d3ffd75e1c"],

