    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z12"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z13"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z23"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z12", " ", "+", " ", "z13"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z12", " ", "+", " ", "z23"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
