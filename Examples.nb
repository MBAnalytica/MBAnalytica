Cell[CellGroupData[{

Cell[TextData[StyleBox["Mellin\[Dash]Barnes Integrals with Fold=4",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Chapter",ExpressionUUID->"d6082f1b-\
130a-48d1-90cc-6a0ae94a7f20"],

Cell[CellGroupData[{

Cell["3-Denominator Single Massive Angular Integral", "Section",ExpressionUUID->"06006c44-915d-4f03-aa0e-86ffb46deaee"],

Cell["\<\
This example is the angular integral of three denominators, one of them \
massive, discussed in Section 6.2 of our paper. The additional variable v11 \
adds a fold, in which the variable z11 enters the Gamma function of the first \
denominator twice.\
\>", "Text",ExpressionUUID->"831e4701-de28-4cf5-86ee-f7c47eb3046c"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"17a0b364-682e-41d2-889b-8ec545bcbebf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"I111m", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "+", " ", 
       RowBox[{"2", " ", "\[Epsilon]"}]}], ")"}]}], " ", 
    RowBox[{"Pi", "^", "\[Epsilon]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "-", " ", "\[Epsilon]"}], "]"}]}], " ", 
    RowBox[{"2", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "-", " ", 
       RowBox[{"2", " ", "\[Epsilon]"}]}], ")"}]}], " ", 
    RowBox[{
     RowBox[{"Pi", "^", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "\[Epsilon]"}], ")"}]}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "-", " ", 
       RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z11"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z12"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z13"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z23"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"2", " ", "z11"}], " ", "+", " ", "z12", " ", "+", " ", "z13"}],
      "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z12", " ", "+", " ", "z23"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z13", " ", "+", " ", "z23"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "-", " ", "\[Epsilon]", " ", "-", " ", "z11", 
      " ", "-", " ", "z12", " ", "-", " ", "z13", " ", "-", " ", "z23"}], 
     "]"}], " ", 
    RowBox[{"v11", "^", "z11"}], " ", 
    RowBox[{"v12", "^", "z12"}], " ", 
    RowBox[{"v13", "^", "z13"}], " ", 
    RowBox[{"v23", "^", "z23"}]}]}], ";"}]], "Input",ExpressionUUID->\
"ea27dd3e-f7ba-4553-9779-ee39ae443fb2"]
}, Closed]],

