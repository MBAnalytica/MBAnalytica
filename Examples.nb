Cell[CellGroupData[{

Cell["Cross-check", "Subsection",ExpressionUUID->"c23a4518-33d0-488e-9e86-2b15f5e4bb95"],

Cell["\<\
Through \[Epsilon]^2, the result agrees with 1 - \[Epsilon] Log[1 - x] + \
\[Epsilon]^2 (PolyLog[2, x] + Log[1 - x]^2), here at x = 1/3.\
\>", "Text",ExpressionUUID->"db6723de-1073-4deb-9a16-9b9bcc2df197"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"NG", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"resF21", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"\[Epsilon]", " ", 
            RowBox[{"Log", "[", 
             RowBox[{"1", " ", "-", " ", "x"}], "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"\[Epsilon]", "^", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"PolyLog", "[", 
               RowBox[{"2", ",", " ", "x"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"1", " ", "-", " ", "x"}], "]"}], "^", "2"}]}], 
             ")"}]}]}], " ", "/.", " ", 
          RowBox[{"x", " ", "->", " ", 
           RowBox[{"1", " ", "-", " ", "y"}]}]}], ")"}]}], ",", " ", 
       "\[Epsilon]", ",", " ", "k"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"y", " ", "->", " ", 
       RowBox[{"2", "/", "3"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"db54a995-43e2-4837-bc83-242cdc2e6b40"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0"}], "}"}]], "Output",ExpressionUUID->\
"5082acd0-6102-498a-8fe8-215055d170b8"]
}, Open  ]]
}, Closed]]
