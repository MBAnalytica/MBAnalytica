Cell[CellGroupData[{

Cell[TextData[StyleBox["Mellin\[Dash]Barnes Integrals with Fold=2",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Chapter",ExpressionUUID->"0635f96c-\
002b-45cb-8ccb-0761ae0fc1a5"],

Cell[CellGroupData[{

Cell["Two-Site Chain in Power-Law FRW Cosmology", "Section",ExpressionUUID->"78f9fd39-72ed-4e9c-a3de-94852fd29605"],

Cell["\<\
This example is the two-site chain of conformally coupled scalars with cubic \
interactions in a power-law FRW cosmology, a(\[Eta]) ~ (-\[Eta])^(-1 - \
\[Epsilon]), discussed in Section 6.4 of our paper. The command CosmoTreeMB \
constructs the MB representation of the time integral of a tree graph, T(x, \
y) = Integrate[Product[t_v^(r_v - 1) Exp[-x_v t_v], v] \
Product[BesselK[\[Nu]_l, y_l t_l^>] BesselI[\[Nu]_l, y_l t_l^<], l]], as one \
balanced MB integral for every orientation of its lines. The integral is the \
sum over the orientations of the prefactors times the values of these MB \
integrals.\
\>", "Text",ExpressionUUID->"16e27093-34e5-4255-8a8d-85ba6b0ffacb"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"2ec1edaa-0840-44d8-890f-5679262005ce"],

Cell["\<\
Every orientation gives a two-fold MB integral. The option \"Point\" \
specifies a kinematic point at which its variables lie in the unit interval.\
\>", "Text",ExpressionUUID->"221e472f-07ef-44ec-8517-804367cdc525"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"T2", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", "-", " ", "\[Epsilon]"}], ",", " ", 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", "-", " ", "\[Epsilon]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"1", "/", "2"}], "}"}], ",", " ", 
     RowBox[{"\"\<Energies\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"X1", ",", " ", "X2"}], "}"}], ",", " ", 
        RowBox[{"{", "Y", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<Point\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"7", "/", "5"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", "/", "3"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T2", "[", 
   RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Integrand\>\"", "]"}]}], "Input",\
ExpressionUUID->"a097df82-d875-477f-b745-58020e68c9cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["u1", "z1"], " ", 
    SuperscriptBox["u2", "z2"], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z1"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", "+", "z1"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z2"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", "+", "z1", "+", "z2", "-", 
      RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", "+", "z1", "+", "z2", "-", "\[Epsilon]"}], "]"}]}], ")"}], "/", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Gamma", "[", 
     RowBox[{"2", "+", "z1"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"2", "+", "z1", "+", "z2", "-", "\[Epsilon]"}], "]"}]}], 
   ")"}]}]], "Output",ExpressionUUID->"6b19709f-d5e8-4b36-bf32-f05f747aed0d"]
}, Open  ]]
}, Closed]],

