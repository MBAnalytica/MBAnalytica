Cell[CellGroupData[{

Cell[TextData[StyleBox["Mellin\[Dash]Barnes Integrals with Fold=3",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Chapter",ExpressionUUID->"751d1c0a-\
5a77-4fb5-8db1-13dbc5bfa5e4"],

Cell[CellGroupData[{

Cell["Hypergeometric Function T3 of Three Variables", "Section",ExpressionUUID->"20b3510e-5d38-4407-b925-fc058901e793"],

Cell["\<\
This example is the function T3 of three variables of MultiHypExp, discussed \
in Section 6.1 of our paper. With u_i = -x_i, it is a three-fold MB integral.\
\
\>", "Text",ExpressionUUID->"d47b3245-bbf4-41a7-94aa-2c5e40444870"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"66737858-2a33-4207-9e07-2f20101892ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"T3", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "+", " ", "\[Epsilon]"}], "]"}], "/", 
     RowBox[{
      RowBox[{"Gamma", "[", "\[Epsilon]", "]"}], "^", "6"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z1"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z2"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z3"}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"\[Epsilon]", " ", "+", " ", "z1"}], "]"}], "^", "2"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"\[Epsilon]", " ", "+", " ", "z2"}], "]"}], "^", "2"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"\[Epsilon]", " ", "+", " ", "z3"}], "]"}], "^", "2"}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{
      "1", " ", "+", " ", "\[Epsilon]", " ", "+", " ", "z1", " ", "+", " ", 
       "z2", " ", "+", " ", "z3"}], "]"}]}], " ", 
    RowBox[{"u1", "^", "z1"}], " ", 
    RowBox[{"u2", "^", "z2"}], " ", 
    RowBox[{"u3", "^", "z3"}]}]}], ";"}]], "Input",ExpressionUUID->"f11c3dd5-\
5a6b-4a0e-b4fa-d1fe674774a2"]
}, Closed]],

