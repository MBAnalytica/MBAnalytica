       RowBox[{"{", 
        RowBox[{"1", ",", " ", "k1", ",", " ", "nu"}], "}"}], "}"}]}], ",", 
     " ", 
     RowBox[{"\"\<Point\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"9", "/", "10"}], ",", " ", 
          RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", "/", "5"}], "}"}], ",", " ", 
        RowBox[{"{", "1", "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K12", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
