Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"$KernelLaunch", " ", "=", " ", "2"}], ";"}], "\n", 
 RowBox[{"<<", " ", "MBAnalytica.wl"}]}], "Input",ExpressionUUID->"fa2dff11-\
c65a-42c3-ab95-845e7dad253a"],

Cell[CellGroupData[{

Cell["\<\
MBAnalytica 1.0.0 - analytic evaluation of Mellin-Barnes integrals in terms \
of multiple polylogarithms.\
\>", "Print",ExpressionUUID->"b5bb487c-6ce7-4e78-9e47-0e05303296b8"],

Cell["\<\
Authors: Taushif Ahmed, Sumit Banik, Syed Mehedi Hasan, Andreas Rapakoulias\
\>", "Print",ExpressionUUID->"8b66cb11-f6cb-4667-b1b4-a35ae55aaa6a"],

Cell["Methods available: SymbolicSum, ExpandInt, Subtraction", "Print",ExpressionUUID->"880426fa-b51d-4498-b140-2b26980191c2"]
}, Open  ]]
}, Open  ]],

Cell["\<\
The results are given in terms of the multiple polylogarithms G of \
PolyLogTools, together with logarithms, classical polylogarithms and zeta \
values. Their numerical values at a kinematic point follow from the interface \
of PolyLogTools to GiNaC, which MBAnalytica configures once an integration \
method (ExpandInt or Subtraction) has run. We use it through the following \
function.\
\>", "Text",ExpressionUUID->"c176e54f-5d23-4f60-b9b2-717d04f01444"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NG", "[", 
   RowBox[{"expr_", ",", " ", "point_List"}], "]"}], " ", ":=", " ", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"$ContextPath", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<PolyLogTools`\>\"", ",", " ", "\"\<System`\>\""}], 
       "}"}]}], "}"}], ",", " ", 
    RowBox[{"PolyLogTools`Ginsh", "[", 
     RowBox[{
      RowBox[{"expr", " ", "/.", " ", "point"}], ",", " ", 
      RowBox[{"{", "}"}]}], "]"}]}], "]"}]}]], "Input",ExpressionUUID->\
"cbef5937-e0e9-45a8-9b33-ac3f82914aa2"]
}, Closed]],

