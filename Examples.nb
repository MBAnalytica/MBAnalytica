Cell[BoxData[
 RowBox[{"?", "MBEvaluate"}]], "Input",ExpressionUUID->"a2d05431-7ec2-4eda-aff4-896e348bd9ca"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox[
             TagBox[
              TooltipBox[
               StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                StripOnInput->False],
               "\"Symbol\"",
               TooltipStyle->"TextStyling"],
              Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"MBEvaluate[MBInt, {Eps, Ord}] returns the expansion \
of the Mellin-Barnes integral MBInt in Eps, from its leading pole through the \
order Eps^Ord, in terms of multiple polylogarithms G, Log, Zeta and \
Pi.\\n\\nMBInt  - the MB integrand, built from Gamma and PolyGamma functions \
and powers of the kinematic variables\\nEps    - the dimensional regulator \
appearing in MBInt\\nOrd    - the deepest order of Eps to be \
evaluated\\n\\nThe integration variables are the variables inside the Gamma \
and PolyGamma functions and the kinematic variables are whatever is left, so \
neither has to be given. MBEvaluate[MBInt, MBVar, {Eps, Ord}] names the \
kinematic variables explicitly; they are taken in 0 < x < 1.\\n\\nA \
coefficient that could not be brought to a closed form is returned as \
MBFailed[reasons].\\n\\nOptions:\\n  Method -> Automatic       tries the \
methods available on this machine in the order \\\"SymbolicSum\\\", \
\\\"ExpandInt\\\", \\\"Subtraction\\\", each one only on the orders the \
earlier ones left open; \\\"SymbolicSum\\\", \\\"ExpandInt\\\" or \
\\\"Subtraction\\\" uses that method alone (\\\"HyperLog\\\" and \\\"Standard\
\\\" are accepted as aliases of \\\"ExpandInt\\\", and \\\"Resum\\\" of \
\\\"SymbolicSum\\\")\\n  Verbose -> False          prints one line per \
stage\\n  BarnesReduce -> True      applies the Barnes lemmas before the \
SymbolicSum method solves the integral\\n  Complex -> False          returns \
the real part; True returns the full complex value\\n\\nExamples:\\n  \
MBEvaluate[MB1, {\[Epsilon], 0}]\\n  MBEvaluate[MB1, {\[Epsilon], 0}, Method \
-> \\\"ExpandInt\\\"]\\n  MBEvaluate[MB1u, {\[Epsilon], -1}, Complex -> True]\
\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[
           TagBox[GridBox[{
              {
               StyleBox[
                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"MBEvaluate", "[", 
                    RowBox[{"MBAnalytica`Private`MBInt_", ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBAnalytica`Private`Eps_Symbol", ",", 
                    "MBAnalytica`Private`Ord_Integer"}], "}"}], ",", 
                    RowBox[{"MBAnalytica`Private`Opts", ":", 
                    RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{"MBEvaluate", "[", 
                    
                    RowBox[{
                    "MBAnalytica`Private`MBInt", ",", "Automatic", ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBAnalytica`Private`Eps", ",", 
                    "MBAnalytica`Private`Ord"}], "}"}], ",", 
                    "MBAnalytica`Private`Opts"}], "]"}]}]}, {" "}, {
                    RowBox[{
                    RowBox[{"MBEvaluate", "[", 
                    
                    RowBox[{
                    "MBAnalytica`Private`MBInt_", ",", 
                    "MBAnalytica`Private`MBVar_", ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBAnalytica`Private`Eps_Symbol", ",", 
                    "MBAnalytica`Private`Ord_Integer"}], "}"}], ",", 
                    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"MBAnalytica`Private`Method1", ",", 
                    "MBAnalytica`Private`Settings", ",", 
                    "MBAnalytica`Private`Methods", ",", 
                    "MBAnalytica`Private`Kinematics", ",", 
                    "MBAnalytica`Private`Lo", ",", 
                    "MBAnalytica`Private`Coefficients", ",", 
                    "MBAnalytica`Private`OpenKeys", ",", 
                    "MBAnalytica`Private`Got", ",", 
                    "MBAnalytica`Private`Finished", ",", 
                    "MBAnalytica`Private`OpenOrders"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"MBAnalytica`Private`Method1", "=", 
                    RowBox[{"OptionValue", "[", "Method", "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"MBAnalytica`Private`Method1", "===", 
                    "\"HyperLog\""}], "||", 
                    
                    RowBox[{"MBAnalytica`Private`Method1", "===", 
                    "\"Standard\""}]}], ",", 
                    
                    RowBox[{"MBAnalytica`Private`Method1", "=", 
                    "\"ExpandInt\""}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"MBAnalytica`Private`Method1", "===", 
                    "\"Resum\""}], ",", 
                    
                    RowBox[{"MBAnalytica`Private`Method1", "=", 
                    "\"SymbolicSum\""}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"MemberQ", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"Automatic", ",", "\"SymbolicSum\"", ",", 
                    "\"ExpandInt\"", ",", "\"Subtraction\""}], "}"}], ",", 
                    "MBAnalytica`Private`Method1"}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    RowBox[{
                    StyleBox[
                    RowBox[{"MBEvaluate", "::", "method"}], "MessageName"], 
                    ",", "MBAnalytica`Private`Method1"}], "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    RowBox[{"MBAnalytica`Private`Settings", "=", 
                    RowBox[{"Association", "[", 
                    RowBox[{
                    RowBox[{"\"Verbose\"", "\[Rule]", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"OptionValue", "[", "Verbose", "]"}], "]"}]}], 
                    ",", 
                    RowBox[{"\"BarnesReduce\"", "\[Rule]", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"OptionValue", "[", "BarnesReduce", "]"}], 
                    "]"}]}], ",", 
                    RowBox[{"\"Complex\"", "\[Rule]", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"OptionValue", "[", "Complex", "]"}], "]"}]}]}], 
                    "]"}]}], ";", 
                    RowBox[{"MBAnalytica`Private`RefreshMethods", "[", "]"}], 
                    ";", 
                    RowBox[{"MBAnalytica`Private`Methods", "=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"MBAnalytica`Private`Method1", "===", 
                    "Automatic"}], ",", "$MBAnalyticaMethods", ",", 
                    RowBox[{"{", "MBAnalytica`Private`Method1", "}"}]}], 
                    "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"MBAnalytica`Private`Methods", "===", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    StyleBox[
                    RowBox[{"MBEvaluate", "::", "none"}], "MessageName"], 
                    "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"MBAnalytica`Private`Method1", "=!=", 
                    "Automatic"}], "&&", 
                    RowBox[{"!", 
                    RowBox[{"MemberQ", "[", 
                    
                    RowBox[{"$MBAnalyticaMethods", ",", 
                    "MBAnalytica`Private`Method1"}], "]"}]}]}], ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    RowBox[{
                    StyleBox[
                    RowBox[{"MBEvaluate", "::", "unavailable"}], 
                    "MessageName"], ",", "MBAnalytica`Private`Method1"}], 
                    "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    RowBox[{"MBAnalytica`Private`Kinematics", "=", 
                    RowBox[{"MBAnalytica`Private`KinematicVariables", "[", 
                    
                    RowBox[{"MBAnalytica`Private`MBInt", ",", 
                    "MBAnalytica`Private`MBVar", ",", 
                    "MBAnalytica`Private`Eps"}], "]"}]}], ";", 
                    RowBox[{"MBAnalytica`Private`Say", "[", 
                    RowBox[{
                    
                    RowBox[{"MBAnalytica`Private`Settings", "[", 
                    "\"Verbose\"", "]"}], ",", "\"MBEvaluate: methods \"", 
                    ",", "MBAnalytica`Private`Methods", ",", 
                    "\", kinematic variables \"", ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"MBAnalytica`Private`Kinematics", "===", 
                    RowBox[{"{", "}"}]}], ",", "\"none\"", ",", 
                    "MBAnalytica`Private`Kinematics"}], "]"}]}], "]"}], ";", 
                    RowBox[{"MBAnalytica`Private`Lo", "=", 
                    RowBox[{"MBAnalytica`Private`LeadingPole", "[", 
                    
                    RowBox[{"MBAnalytica`Private`MBInt", ",", 
                    "MBAnalytica`Private`Eps", ",", 
                    "MBAnalytica`Private`Ord"}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    
                    RowBox[{"IntegerQ", "[", "MBAnalytica`Private`Lo", 
                    "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    StyleBox[
                    RowBox[{"MBEvaluate", "::", "pole"}], "MessageName"], 
                    "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    RowBox[{"MBAnalytica`Private`Say", "[", 
                    RowBox[{
                    
                    RowBox[{"MBAnalytica`Private`Settings", "[", 
                    "\"Verbose\"", "]"}], ",", "\"MBEvaluate: orders \"", ",",
                     "MBAnalytica`Private`Eps", ",", "\"^\"", ",", 
                    "MBAnalytica`Private`Lo", ",", "\" through \"", ",", 
                    "MBAnalytica`Private`Eps", ",", "\"^\"", ",", 
                    "MBAnalytica`Private`Ord"}], "]"}], ";", 
                    RowBox[{"MBAnalytica`Private`Coefficients", "=", 
                    RowBox[{"Association", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#1", "\[Rule]", 
                    RowBox[{"MBFailed", "[", 
                    RowBox[{"{", "\"not attempted\"", "}"}], "]"}]}], "&"}], 
                    ")"}], "/@", 
                    RowBox[{"Range", "[", 
                    
                    RowBox[{"MBAnalytica`Private`Lo", ",", 
                    "MBAnalytica`Private`Ord"}], "]"}]}], "]"}]}], ";", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"MBAnalytica`Private`OpenKeys", "=", 
