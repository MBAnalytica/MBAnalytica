Cell[CellGroupData[{

Cell["Exchange of a Scalar of Nearly Conformal Mass", "Section",ExpressionUUID->"f599f39c-b29e-4710-9087-394f982dfc27"],

Cell["\<\
This example is the two-site exchange of a scalar of mass m^2 = (9/4 - \
\[Nu]^2) H^2 in de Sitter space with \[Nu] = 1/2 - \[Delta], discussed in \
Section 6.4 of our paper. The regulator \[Epsilon] stands for \[Delta].\
\>", "Text",ExpressionUUID->"ac905aea-5af6-4e48-9435-3e1c618e4532"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"c7f88f56-b628-4a62-bee5-69ad8a42ec83"],

Cell["Every orientation gives a three-fold MB integral.", "Text",ExpressionUUID->"67df54a3-b017-4528-8b3a-ff449d12316a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tc2", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "-", " ", "\[Epsilon]"}], "}"}], ",", 
     " ", 
     RowBox[{"\"\<Energies\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"X1", ",", " ", "X2"}], "}"}], ",", " ", 
        RowBox[{"{", "Y", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<Point\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"3", "/", "2"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", "/", "3"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",\
ExpressionUUID->"3b41c648-d1c8-47e6-ba43-fb789ccc1b47"]
}, Closed]],

