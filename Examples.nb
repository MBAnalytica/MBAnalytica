Cell[CellGroupData[{

Cell[TextData[StyleBox["Mellin\[Dash]Barnes Integrals with Fold=6",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Chapter",ExpressionUUID->"9d6c4d29-\
c281-4b51-a29d-2bbf8a5ca789"],

Cell[CellGroupData[{

Cell["Double Exchange near the Conformal Mass", "Section",ExpressionUUID->"5f00bb2f-d109-42c0-9ccc-fbbb17e808c8"],

Cell["\<\
This example is the bispectrum generated by the double exchange of a massive \
scalar, discussed in Section 6.4 of our paper. The channel with the cubic \
vertex at the momentum k2 is the combination A = 2 \[Psi]KIKI + \
(2/\[Pi])(Sin[\[Pi] \[Nu]] - 1)[\[CapitalPhi]1 \[Psi]K23 + \[CapitalPhi]3 \
\[Psi]K12 + (2/\[Pi]) Sin[\[Pi] \[Nu]] \[CapitalPhi]1 \[CapitalPhi]3 \
\[Psi]KK] of four tree integrals, with \[CapitalPhi]i = Sqrt[\[Pi]/(2 ki)] \
\[CapitalGamma](1/2 + \[Nu]) \[CapitalGamma](1/2 - \[Nu]) = Sqrt[\[Pi]/(2 \
ki)] \[Pi]/Cos[\[Pi] \[Nu]]. Here \[Nu] = 1/2 - \[Delta].\
\>", "Text",ExpressionUUID->"c6680f41-3950-4970-92af-ce35e4048a41"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"c1402eb5-4989-4f5b-b874-51365ca09e34"],

Cell["\<\
The option \"KLegs\" adds the factors BesselK of the cut lines. The nine MB \
integrals of the four tree integrals have two to six folds.\
\>", "Text",ExpressionUUID->"22649cb1-2cdf-4ded-bc8c-d92485ab8445"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nu", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", "-", " ", "\[Epsilon]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"KIKI", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", "2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"nu", ",", " ", "nu"}], "}"}], ",", " ", 
     RowBox[{"\"\<Energies\>\"", " ", "->", " ", 
      RowBox[{"{", 
