Cell[CellGroupData[{

Cell[TextData[StyleBox["Mellin\[Dash]Barnes Integrals with Fold=7",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Chapter",ExpressionUUID->"58c75603-\
1a4f-49c4-8ec0-e63de9e63cc3"],

Cell[CellGroupData[{

Cell["Master Integral for N4LO Higgs Production", "Section",ExpressionUUID->"b451ce62-cc5f-49c6-bcb2-80d5379fcfc4"],

Cell["\<\
This example is a seven-fold MB integral I(u, \[Epsilon]) of Higgs-boson \
production at N4LO, one of the master integrals that contribute to the RRV\
\[Times]V corrections, differential in the variable 0 < u < 1, discussed in \
Section 6.3 of our paper.\
\>", "Text",ExpressionUUID->"6fef089c-36ba-4022-94be-31f0f581b4c0"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"a8134634-b851-42e0-84be-37e4a7eb1889"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Iu", " ", "=", " ", 
   RowBox[{
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{"2", " ", "EulerGamma", " ", "\[Epsilon]"}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"4", " ", "-", " ", 
      RowBox[{"4", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", "4"}], " ", "\[Epsilon]"}], "]"}], "^", "2"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"-", "\[Epsilon]"}], "]"}], "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"1", " ", "-", " ", "\[Epsilon]"}], "]"}], "^", "3"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"-", "8"}], " ", "\[Epsilon]"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"-", "2"}], " ", "\[Epsilon]"}], "]"}], "^", "2"}]}], 
      ")"}]}], " ", 
    RowBox[{"u", "^", 
     RowBox[{"(", 
      RowBox[{"z1", " ", "+", " ", "z2", " ", "-", " ", "\[Epsilon]"}], 
      ")"}]}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "u"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"z3", " ", "+", " ", "z4", " ", "-", " ", "\[Epsilon]"}], 
      ")"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"z6", " ", "-", " ", 
      RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"z7", " ", "-", " ", 
       RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"z6", " ", "+", " ", "z7", " ", "-", " ", 
         RowBox[{"6", " ", "\[Epsilon]"}]}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"z7", " ", "-", " ", "z5", " ", "-", " ", 
         RowBox[{"3", " ", "\[Epsilon]"}]}], "]"}]}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z1"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z2"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z3"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z4"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z5"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z6"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z6"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z7"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z7"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "-", " ", "z1", " ", "-", " ", "z4", " ", "-", 
      " ", "z5", " ", "+", " ", "z7", " ", "-", " ", 
      RowBox[{"4", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"-", "z2"}], " ", "-", " ", "z3", " ", "-", " ", "z5", " ", "+",
       " ", "z6", " ", "+", " ", "z7", " ", "-", " ", 
      RowBox[{"4", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
     "1", " ", "+", " ", "z1", " ", "+", " ", "z4", " ", "+", " ", 
      "\[Epsilon]"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
     "1", " ", "+", " ", "z1", " ", "+", " ", "z3", " ", "+", " ", "z5", " ", 
      "+", " ", "\[Epsilon]"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
     "z2", " ", "+", " ", "z3", " ", "-", " ", "z6", " ", "+", " ", 
      "\[Epsilon]"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
     "z2", " ", "+", " ", "z4", " ", "+", " ", "z5", " ", "-", " ", "z7", " ",
       "+", " ", "\[Epsilon]"}], "]"}]}]}], ";"}]], "Input",ExpressionUUID->\
"a988bf39-784b-4188-95cd-1af950187ade"]
}, Closed]],

Cell[CellGroupData[{

Cell["Evaluation", "Subsection",ExpressionUUID->"44b62433-f537-4101-a455-9a8c1a03a98c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resIu", " ", "=", " ", 
   RowBox[{"MBEvaluate", "[", 
    RowBox[{"Iu", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", " ", 
       RowBox[{"-", "3"}]}], "}"}], ",", " ", 
     RowBox[{"Method", " ", "->", " ", "\"\<ExpandInt\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"Series", "[", 
   RowBox[{"resIu", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", ",", " ", "0", ",", " ", 
      RowBox[{"-", "4"}]}], "}"}]}], "]"}], "]"}]}], "Input",ExpressionUUID->\
"3f1a971e-4044-4b1e-9e42-5a7fbad75778"],

Cell[BoxData[
 RowBox[{
  FractionBox["3", 
   RowBox[{"u", " ", 
    SuperscriptBox["\[Epsilon]", "6"]}]], "-", 
  FractionBox[
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{"11", "+", 
      RowBox[{"6", " ", 
       RowBox[{"Log", "[", "u", "]"}]}]}], ")"}]}], 
   RowBox[{"u", " ", 
    SuperscriptBox["\[Epsilon]", "5"]}]], "+", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"2", " ", "u", " ", 
     SuperscriptBox["\[Epsilon]", "4"]}]], 
   RowBox[{"(", 
    RowBox[{"96", "-", 
     RowBox[{"7", " ", 
      SuperscriptBox["\[Pi]", "2"]}], "-", 
     RowBox[{"6", " ", 
      RowBox[{"G", "[", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"1", "-", "u"}]], ",", "1"}], "]"}], " ", 
      RowBox[{"G", "[", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", "u"}], "u"], ",", "1"}], "]"}]}], "+", 
     RowBox[{"12", " ", 
      RowBox[{"G", "[", 
       RowBox[{
        FractionBox["1", "u"], ",", "1"}], "]"}], " ", 
      RowBox[{"G", "[", 
       RowBox[{
        FractionBox["u", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "u"}]], ",", "1"}], "]"}]}], "-", 
     RowBox[{"6", " ", 
      RowBox[{"G", "[", 
       RowBox[{"0", ",", 
        FractionBox["1", 
         RowBox[{"1", "-", "u"}]], ",", "1"}], "]"}]}], "+", 
     RowBox[{"12", " ", 
      RowBox[{"G", "[", 
       RowBox[{"0", ",", 
        FractionBox["1", "u"], ",", "1"}], "]"}]}], "-", 
     RowBox[{"9", " ", 
      SuperscriptBox[
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", "u"}], "]"}], "2"]}], "+", 
     RowBox[{"176", " ", 
      RowBox[{"Log", "[", "u", "]"}]}], "+", 
     RowBox[{"48", " ", 
      SuperscriptBox[
       RowBox[{"Log", "[", "u", "]"}], "2"]}], "-", 
     RowBox[{"6", " ", 
      RowBox[{"G", "[", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", "u"}], "u"], ",", "1"}], "]"}], " ", 
      RowBox[{"Re", "[", 
       RowBox[{"G", "[", 
        RowBox[{
         RowBox[{"1", "-", "u"}], ",", "1"}], "]"}], "]"}]}], "+", 
     RowBox[{"6", " ", 
      RowBox[{"Re", "[", 
       RowBox[{"G", "[", 
        RowBox[{"0", ",", 
         RowBox[{"1", "-", "u"}], ",", "1"}], "]"}], "]"}]}]}], 
    ")"}]}]}]], "Output",ExpressionUUID->"d7e088e2-1c23-42bf-8e52-\
6d6c828c0464"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Cross-check", "Subsection",ExpressionUUID->"af2341bb-446e-478d-bb9a-72eb9c27de9e"],

Cell["\<\
The leading three orders agree with the expansion given in Section 6.3 of our \
paper, in which G(0, 1; u) = -Li2(u), here at u = 1/3.\
\>", "Text",ExpressionUUID->"bb7d4b31-b7ec-4278-b6d6-3c319189a150"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"NG", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"resIu", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", "/", 
           RowBox[{"(", 
            RowBox[{"u", " ", 
             RowBox[{"\[Epsilon]", "^", "6"}]}], ")"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"22", " ", "+", " ", 
             RowBox[{"12", " ", 
              RowBox[{"Log", "[", "u", "]"}]}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"u", " ", 
             RowBox[{"\[Epsilon]", "^", "5"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"48", " ", "-", " ", 
             RowBox[{"7", " ", 
              RowBox[{
               RowBox[{"Pi", "^", "2"}], "/", "2"}]}], " ", "-", " ", 
             RowBox[{"12", " ", 
              RowBox[{"PolyLog", "[", 
               RowBox[{"2", ",", " ", "u"}], "]"}]}], " ", "+", " ", 
             RowBox[{"88", " ", 
              RowBox[{"Log", "[", "u", "]"}]}], " ", "+", " ", 
             RowBox[{"24", " ", 
              RowBox[{
               RowBox[{"Log", "[", "u", "]"}], "^", "2"}]}], " ", "-", " ", 
             RowBox[{"6", " ", 
              RowBox[{"Log", "[", 
               RowBox[{"1", " ", "-", " ", "u"}], "]"}], " ", 
              RowBox[{"Log", "[", "u", "]"}]}], " ", "-", " ", 
             RowBox[{"6", " ", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"1", " ", "-", " ", "u"}], "]"}], "^", "2"}]}]}], 
            ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"u", " ", 
             RowBox[{"\[Epsilon]", "^", "4"}]}], ")"}]}]}], ")"}]}], ",", " ",
        "\[Epsilon]", ",", " ", "k"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", " ", "->", " ", 
       RowBox[{"1", "/", "3"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
