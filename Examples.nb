                    RowBox[{
                    RowBox[{"Head", "[", 
                    
                    RowBox[{"MBAnalytica`Private`Coefficients", "[", "#1", 
                    "]"}], "]"}], "===", "MBFailed"}], "&"}]}], "]"}]}], ";", 
                    
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"MBAnalytica`Private`OpenKeys", "===", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
