Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox[
             TagBox[
              TooltipBox[
               StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                StripOnInput->False],
               "\"Symbol\"",
               TooltipStyle->"TextStyling"],
              Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"CosmoTreeMB[lines, r, nu] gives balanced unit-slope \
MB integrals, one per orientation of the lines, for the de Sitter tree time \
integral Int prod_v dt_v t_v^(r_v - 1) Exp[-x_v t_v] prod_l BesselK[nu_l, y_l \
t>] BesselI[nu_l, y_l t<]. lines lists the vertex pairs {v, w} of a tree on \
the vertices 1, ..., Length[r]; nu lists the Bessel orders. Each result is an \
association: \\\"Integrand\\\" (the MB, for MBEvaluate), \\\"Variables\\\" \
(the MB variables in the energies), \\\"Prefactor\\\", \\\"Later\\\" (the \
later vertex of each line), \\\"Push\\\" and \\\"Base\\\"; the integral is \
the sum over the orientations of Prefactor times the integrand's value. \
Options: \\\"Energies\\\" -> {{x1, ...}, {y1, ...}}, \\\"Point\\\" -> numeric \
energies (needed to choose positive rewritings), \\\"KLegs\\\" -> {{v, \
energy, nu}, ...} (factors BesselK[nu, energy t_v] of an in-in block), \
\\\"Orientations\\\", \\\"VariableName\\\", and \\\"LightSplit\\\" -> True \
(for light fields, the powers (2 + v)^(nu - 1/2) are split by the binomial \
theorem and every term is returned as a separate integral, selected by \
