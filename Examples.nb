Cell[CellGroupData[{

Cell[TextData[StyleBox["Mellin\[Dash]Barnes Integrals with Fold=1",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Chapter",ExpressionUUID->"656b6cec-\
83f2-4a1d-b2d8-e6d3906bbc48"],

Cell[CellGroupData[{

Cell["Integral of the Installation Test", "Section",ExpressionUUID->"8debbceb-dea2-4df3-8fb1-21d72e15021a"],

Cell["\<\
This example is the one-fold integral J(\[Epsilon]) of the installation test, \
discussed in Section 5.4 of our paper. As \[Epsilon] \[Rule] 0, the poles of \
Gamma[z + \[Epsilon]] and Gamma[-z] pinch the contour, and together with the \
prefactor Gamma[\[Epsilon]] the continuation produces a pole of third order. \
The integrand is entered as it stands.\
\>", "Text",ExpressionUUID->"8b31734a-6d3b-4784-a17e-ce5d2b4806a5"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"35ab7b9a-a9bc-4e26-90ca-7167d33e962d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MB1", " ", "=", " ", 
   RowBox[{
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"EulerGamma", " ", "+", " ", 
         RowBox[{"I", " ", "Pi"}]}], ")"}], " ", "\[Epsilon]"}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", "\[Epsilon]", "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"2", " ", "-", " ", 
      RowBox[{"4", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"4", " ", "-", " ", 
       RowBox[{"4", " ", "\[Epsilon]"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"2", " ", "-", " ", 
         RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"4", " ", "-", " ", 
         RowBox[{"8", " ", "\[Epsilon]"}]}], "]"}]}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "-", " ", "z", " ", "-", " ", 
      RowBox[{"3", " ", "\[Epsilon]"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z", " ", "-", " ", "\[Epsilon]"}], "]"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"z", " ", "+", " ", "\[Epsilon]"}], "]"}], "^", "2"}], "/", 
     RowBox[{"Gamma", "[", 
