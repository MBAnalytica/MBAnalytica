  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "MBAnalyticaCheck[] prints which dependencies of MBAnalytica were found \
on this machine, what to do about each missing one, and which methods can \
run. It returns an association with the same information.", "Documentation" -> 
    None, "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, $CellContext`MBAnalyticaCheck, \
{$CellContext`MBAnalyticaCheck[] :> 
       Module[{MBAnalytica`Private`Results, MBAnalytica`Private`Lines}, 
         MBAnalytica`Private`Results = MBAnalytica`Private`RefreshMethods[]; 
         MBAnalytica`Private`Lines = Map[Row[{
              If[
               #["Found"], 
               Style["  found    ", 
                Darker[Green]], 
               Style["  MISSING  ", Red]], 
              Style[
               #["Name"], Bold], "  (" <> #["Kind"] <> "; needed by " <> 
              StringRiffle[
                #["Methods"], ", "] <> ")", 
              If[
               #["Found"], "", "\n             " <> #["Hint"]]}]& , 
            MBAnalytica`Private`Results]; 
         Scan[Print, MBAnalytica`Private`Lines]; Print[
           Row[{
             Style["Methods available on this machine: ", Bold], 
             If[$CellContext`$MBAnalyticaMethods === {}, 
              Style["none", Red], 
              StringRiffle[$CellContext`$MBAnalyticaMethods, ", "]]}]]; 
         Return[<|"Methods" -> $CellContext`$MBAnalyticaMethods, 
            "Dependencies" -> <|
              
              Map[#["Name"] -> #["Found"]& , 
               MBAnalytica`Private`Results]|>|>]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "MBAnalytica`MBAnalyticaCheck"|>, False]]], "Output",ExpressionUUID->\
"86fa9e45-5e18-475d-acc0-bcb62a1f62de"]
}, Open  ]],

