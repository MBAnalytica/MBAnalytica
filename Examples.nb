         RowBox[{"k1", ",", " ", "k2"}], "}"}], ",", " ", 
        RowBox[{"{", "k1", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<KLegs\>\"", " ", "->", " ", 
