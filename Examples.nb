       RowBox[{"-", "2"}], " ", "\[Epsilon]"}], "]"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z12"}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "+", " ", "z12"}], "]"}], "^", "2"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "-", " ", "\[Epsilon]", " ", "-", " ", "z12"}],
      "]"}], " ", 
    RowBox[{"v12", "^", "z12"}]}]}], ";"}]], "Input",ExpressionUUID->\
"1e2db1e5-9946-4936-863d-3c434a62a969"]
}, Closed]],

