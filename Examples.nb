Cell[CellGroupData[{

Cell["Double Exchange of a Light Field", "Section",ExpressionUUID->"69a8758d-cdd5-42e8-b5db-d882d71f9aa8"],

Cell["\<\
This example is the same bispectrum for a light field, \[Nu] = 3/2 - \
\[Delta], discussed in Section 6.4 of our paper. The Poisson integrals \
contain powers (2 + v)^(\[Nu] - 1/2) whose MB splitting admits no straight \
contour. The option \"LightSplit\" separates the integer part of the exponent \
by the binomial theorem, and CosmoTreeMB returns every term of the split as a \
separate integral.\
\>", "Text",ExpressionUUID->"60c5d835-7188-4760-b797-fe32a3d5cada"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"6763a040-2065-483a-83f4-d26d69ec4b8c"],

Cell["\<\
For example, the integral \[Psi]K23 is split into eight MB integrals of three \
and four folds.\
\>", "Text",ExpressionUUID->"8f086b29-14b0-42ca-80c2-3e0259697880"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nu", " ", "=", " ", 
   RowBox[{
    RowBox[{"3", "/", "2"}], " ", "-", " ", "\[Epsilon]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K23", " ", "=", " ", 
   RowBox[{"CosmoTreeMB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", "nu", "}"}], ",", " ", 
     RowBox[{"\"\<Energies\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k2", ",", " ", "k3"}], "}"}], ",", " ", 
        RowBox[{"{", "k3", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<KLegs\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "k1", ",", " ", "nu"}], "}"}], "}"}]}], ",", 
     " ", 
     RowBox[{"\"\<Point\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"9", "/", "10"}], ",", " ", 
          RowBox[{"4", "/", "5"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", "/", "5"}], "}"}], ",", " ", 
        RowBox[{"{", "1", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<LightSplit\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Length", "[", "K23", "]"}]}], "Input",ExpressionUUID->"bf07dc37-\
587d-473a-8e50-593a84042212"],

Cell[BoxData["8"], "Output",ExpressionUUID->"5c026c86-1113-423d-8d8c-767d36775bdb"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Evaluation", "Subsection",ExpressionUUID->"d09ff83c-22ea-4726-a7ed-221327ef9915"],

Cell["\<\
The coefficients of \[Psi]K23 through \[Delta]^2 agree with a direct \
numerical integration of the Bessel time integral at small values of \[Delta] \
(Section 6.5 of our paper).\
\>", "Text",ExpressionUUID->"086800b7-d2f8-47f3-81f0-457262f9ae9e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"psiK23", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "[", "\"\<Prefactor\>\"", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"MBEvaluate", "[", 
         RowBox[{
          RowBox[{"b", "[", "\"\<Integrand\>\"", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Subtraction\>\""}]}], "]"}], 
        " ", "/.", " ", 
        RowBox[{"b", "[", "\"\<Variables\>\"", "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "K23"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"NG", "[", 
    RowBox[{
     RowBox[{"SeriesCoefficient", "[", 
      RowBox[{"psiK23", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", ",", " ", "0", ",", " ", "k"}], "}"}]}], "]"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k1", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"k2", " ", "->", " ", 
        RowBox[{"9", "/", "10"}]}], ",", " ", 
       RowBox[{"k3", " ", "->", " ", 
        RowBox[{"4", "/", "5"}]}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], "Input",Exp\
ressionUUID->"5e215d72-78ae-4615-8087-d095759ce920"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.236441432748308862501804959749371827257`38.373723582349996", ",", 
   RowBox[{
   "-", "0.280611940590524738426006991465494318467`38.448106147170755"}], ",",
    "0.46198535999080302459505828173136016997`37.66462821327052"}], 
  "}"}]], "Output",ExpressionUUID->"a2343cb3-3c74-454c-9983-f4fdfc47dd87"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Closed Form", "Subsection",ExpressionUUID->"a994e927-e481-472d-8b7e-1fdc2a105e2e"],

Cell["\<\
The closed forms of the coefficients of A through \[Delta]^1, assembled from \
the Subtraction results of the thirty MB integrals of the light split, are \
stored in the following cell, as an association from the order of \[Delta] to \
its coefficient.\
\>", "Text",ExpressionUUID->"4663c6c7-a76c-4c66-80e8-c6709f7c0c15"],

