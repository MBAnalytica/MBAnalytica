      RowBox[{
       FractionBox["1", "y"], ",", "0", ",", 
       FractionBox["1", "y"], ",", "1"}], "]"}], "+", 
     RowBox[{
      FractionBox["1", "6"], " ", 
      SuperscriptBox["\[Pi]", "2"], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "y"}], "]"}]}], "-", 
     RowBox[{
      FractionBox["1", "3"], " ", 
      SuperscriptBox["\[Pi]", "2"], " ", 
      RowBox[{"Log", "[", "y", "]"}]}], "-", 
     RowBox[{
      RowBox[{"G", "[", 
       RowBox[{"0", ",", "1", ",", "y"}], "]"}], " ", 
      RowBox[{"Log", "[", "y", "]"}]}], "+", 
