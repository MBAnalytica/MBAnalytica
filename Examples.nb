Cell[CellGroupData[{

Cell["Gauss Hypergeometric Function 2F1", "Section",ExpressionUUID->"28b2a39a-e581-4f4a-b9f8-5d1726d317ec"],

Cell["\<\
This example is the Gauss function 2F1(1, \[Epsilon]; 1 - \[Epsilon]; x) from \
its MB representation, discussed in Section 6.1 of our paper. The kinematic \
variable of the MB integral is y = 1 - x.\
\>", "Text",ExpressionUUID->"d29af8a0-edc1-45d5-80cd-2e9aa6b3cf5a"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"dc6224c1-8ecc-44ac-85dc-4bd77e264365"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F21", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "-", " ", "\[Epsilon]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Gamma", "[", "\[Epsilon]", "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"-", "\[Epsilon]"}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}]}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "z"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"\[Epsilon]", " ", "+", " ", "z"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[Epsilon]"}], " ", "-", " ", "z"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "z"}], "]"}], " ", 
    RowBox[{"y", "^", "z"}]}]}], ";"}]], "Input",ExpressionUUID->"37f60751-\
f6c4-4170-925a-0c696bca8de4"]
}, Closed]],

Cell[CellGroupData[{

Cell["Evaluation", "Subsection",ExpressionUUID->"da7380e8-b9d5-46b2-8da3-db8ed00d95c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resF21", " ", "=", " ", 
  RowBox[{"MBEvaluate", "[", 
   RowBox[{"F21", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", ",", " ", "3"}], "}"}], ",", " ", 
