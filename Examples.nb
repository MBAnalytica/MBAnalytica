  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "MBEvaluate[MBInt, {Eps, Ord}] returns the expansion of the Mellin-Barnes \
integral MBInt in Eps, from its leading pole through the order Eps^Ord, in \
terms of multiple polylogarithms G, Log, Zeta and Pi.\n\nMBInt  - the MB \
integrand, built from Gamma and PolyGamma functions and powers of the \
kinematic variables\nEps    - the dimensional regulator appearing in MBInt\n\
Ord    - the deepest order of Eps to be evaluated\n\nThe integration \
variables are the variables inside the Gamma and PolyGamma functions and the \
kinematic variables are whatever is left, so neither has to be given. \
MBEvaluate[MBInt, MBVar, {Eps, Ord}] names the kinematic variables \
explicitly; they are taken in 0 < x < 1.\n\nA coefficient that could not be \
brought to a closed form is returned as MBFailed[reasons].\n\nOptions:\n  \
Method -> Automatic       tries the methods available on this machine in the \
order \"SymbolicSum\", \"ExpandInt\", \"Subtraction\", each one only on the \
orders the earlier ones left open; \"SymbolicSum\", \"ExpandInt\" or \
\"Subtraction\" uses that method alone (\"HyperLog\" and \"Standard\" are \
accepted as aliases of \"ExpandInt\", and \"Resum\" of \"SymbolicSum\")\n  \
Verbose -> False          prints one line per stage\n  BarnesReduce -> True   \
   applies the Barnes lemmas before the SymbolicSum method solves the \
integral\n  Complex -> False          returns the real part; True returns the \
full complex value\n\nExamples:\n  MBEvaluate[MB1, {\[Epsilon], 0}]\n  \
MBEvaluate[MB1, {\[Epsilon], 0}, Method -> \"ExpandInt\"]\n  MBEvaluate[MB1u, \
{\[Epsilon], -1}, Complex -> True]", "Documentation" -> None, "OwnValues" -> 
    None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, $CellContext`MBEvaluate, {$CellContext`MBEvaluate[
         Pattern[MBAnalytica`Private`MBInt, 
          Blank[]], {
          Pattern[MBAnalytica`Private`Eps, 
           Blank[Symbol]], 
          Pattern[MBAnalytica`Private`Ord, 
           Blank[Integer]]}, 
         Pattern[MBAnalytica`Private`Opts, 
          OptionsPattern[]]] :> $CellContext`MBEvaluate[
        MBAnalytica`Private`MBInt, Automatic, {
         MBAnalytica`Private`Eps, MBAnalytica`Private`Ord}, 
         MBAnalytica`Private`Opts], $CellContext`MBEvaluate[
         Pattern[MBAnalytica`Private`MBInt, 
          Blank[]], 
         Pattern[MBAnalytica`Private`MBVar, 
          Blank[]], {
          Pattern[MBAnalytica`Private`Eps, 
           Blank[Symbol]], 
          Pattern[MBAnalytica`Private`Ord, 
           Blank[Integer]]}, 
         OptionsPattern[]] :> 
       Module[{MBAnalytica`Private`Method1, MBAnalytica`Private`Settings, 
          MBAnalytica`Private`Methods, MBAnalytica`Private`Kinematics, 
          MBAnalytica`Private`Lo, MBAnalytica`Private`Coefficients, 
          MBAnalytica`Private`OpenKeys, MBAnalytica`Private`Got, 
          MBAnalytica`Private`Finished, MBAnalytica`Private`OpenOrders}, 
         MBAnalytica`Private`Method1 = OptionValue[Method]; If[
           Or[
           MBAnalytica`Private`Method1 === "HyperLog", 
            MBAnalytica`Private`Method1 === "Standard"], 
           MBAnalytica`Private`Method1 = "ExpandInt"]; 
         If[MBAnalytica`Private`Method1 === "Resum", 
           MBAnalytica`Private`Method1 = "SymbolicSum"]; If[
           Not[
            
            MemberQ[{Automatic, "SymbolicSum", "ExpandInt", "Subtraction"}, 
             MBAnalytica`Private`Method1]], Message[
             MessageName[$CellContext`MBEvaluate, "method"], 
             MBAnalytica`Private`Method1]; Return[$Failed]]; 
         MBAnalytica`Private`Settings = <|"Verbose" -> TrueQ[
              OptionValue[Verbose]], "BarnesReduce" -> TrueQ[
              OptionValue[$CellContext`BarnesReduce]], "Complex" -> TrueQ[
              OptionValue[Complex]]|>; MBAnalytica`Private`RefreshMethods[]; 
         MBAnalytica`Private`Methods = 
          If[MBAnalytica`Private`Method1 === 
            Automatic, $CellContext`$MBAnalyticaMethods, {
            MBAnalytica`Private`Method1}]; 
         If[MBAnalytica`Private`Methods === {}, Message[
             MessageName[$CellContext`MBEvaluate, "none"]]; Return[$Failed]]; 
         If[
           And[MBAnalytica`Private`Method1 =!= Automatic, 
            Not[
             
             MemberQ[$CellContext`$MBAnalyticaMethods, 
              MBAnalytica`Private`Method1]]], Message[
             MessageName[$CellContext`MBEvaluate, "unavailable"], 
             MBAnalytica`Private`Method1]; Return[$Failed]]; 
         MBAnalytica`Private`Kinematics = 
          MBAnalytica`Private`KinematicVariables[
           MBAnalytica`Private`MBInt, MBAnalytica`Private`MBVar, 
            MBAnalytica`Private`Eps]; MBAnalytica`Private`Say[
           MBAnalytica`Private`Settings["Verbose"], "MBEvaluate: methods ", 
           MBAnalytica`Private`Methods, ", kinematic variables ", 
           If[
           MBAnalytica`Private`Kinematics === {}, "none", 
            MBAnalytica`Private`Kinematics]]; 
         MBAnalytica`Private`Lo = 
          MBAnalytica`Private`LeadingPole[
           MBAnalytica`Private`MBInt, MBAnalytica`Private`Eps, 
            MBAnalytica`Private`Ord]; If[
           Not[
            IntegerQ[MBAnalytica`Private`Lo]], Message[
             MessageName[$CellContext`MBEvaluate, "pole"]]; Return[$Failed]]; 
         MBAnalytica`Private`Say[
           MBAnalytica`Private`Settings["Verbose"], "MBEvaluate: orders ", 
           MBAnalytica`Private`Eps, "^", MBAnalytica`Private`Lo, " through ", 
           MBAnalytica`Private`Eps, "^", MBAnalytica`Private`Ord]; 
         MBAnalytica`Private`Coefficients = <|
            Map[# -> $CellContext`MBFailed[{"not attempted"}]& , 
             Range[MBAnalytica`Private`Lo, MBAnalytica`Private`Ord]]|>; 
         Do[MBAnalytica`Private`OpenKeys = Select[
              Keys[MBAnalytica`Private`Coefficients], Head[
                
                MBAnalytica`Private`Coefficients[#]] === \
$CellContext`MBFailed& ]; If[MBAnalytica`Private`OpenKeys === {}, 
             Break[]]; MBAnalytica`Private`Say[
             MBAnalytica`Private`Settings["Verbose"], "MBEvaluate: ", 
             MBAnalytica`Private`M1, " on ", MBAnalytica`Private`Eps, "^", 
             Min[MBAnalytica`Private`OpenKeys], " .. ", 
             MBAnalytica`Private`Eps, "^", 
             Max[MBAnalytica`Private`OpenKeys]]; 
           MBAnalytica`Private`Got = 
            MBAnalytica`Private`RunMethod[
             MBAnalytica`Private`M1, MBAnalytica`Private`MBInt, 
              MBAnalytica`Private`MBVar, MBAnalytica`Private`Kinematics, 
              MBAnalytica`Private`Eps, 
              Min[MBAnalytica`Private`OpenKeys], 
              Max[MBAnalytica`Private`OpenKeys], 
              MBAnalytica`Private`Settings]; Scan[
             Function[MBAnalytica`Private`K1, 
              If[
               And[
                KeyExistsQ[MBAnalytica`Private`Got, MBAnalytica`Private`K1], 
                Head[
                  MBAnalytica`Private`Got[
                  MBAnalytica`Private`K1]] =!= $CellContext`MBFailed], 
               MBAnalytica`Private`Coefficients[MBAnalytica`Private`K1] = 
               MBAnalytica`Private`Got[MBAnalytica`Private`K1]]], 
             MBAnalytica`Private`OpenKeys]; Scan[
             Function[MBAnalytica`Private`K1, 
              If[
               And[
                KeyExistsQ[MBAnalytica`Private`Got, MBAnalytica`Private`K1], 
                Head[
                  MBAnalytica`Private`Got[
                  MBAnalytica`Private`K1]] === $CellContext`MBFailed], 
               MBAnalytica`Private`Coefficients[MBAnalytica`Private`K1] = 
               MBAnalytica`Private`Got[MBAnalytica`Private`K1]]], 
             Select[MBAnalytica`Private`OpenKeys, Head[
                
                MBAnalytica`Private`Coefficients[#]] === \
$CellContext`MBFailed& ]], {
           MBAnalytica`Private`M1, MBAnalytica`Private`Methods}]; 
         MBAnalytica`Private`OpenOrders = Select[
            Keys[MBAnalytica`Private`Coefficients], Head[
              
              MBAnalytica`Private`Coefficients[#]] === $CellContext`MBFailed& \
]; If[MBAnalytica`Private`OpenOrders =!= {}, 
           Message[
            MessageName[$CellContext`MBEvaluate, "open"], 
            Map[
            MBAnalytica`Private`Eps^#& , MBAnalytica`Private`OpenOrders]]]; 
         MBAnalytica`Private`Finished = <|
            
            KeyValueMap[# -> 
             MBAnalytica`Private`FinishCoefficient[#2, 
               MBAnalytica`Private`Kinematics, 
               MBAnalytica`Private`Settings["Complex"]]& , 
             MBAnalytica`Private`Coefficients]|>; 
         MBAnalytica`Private`ShowOutputContexts[]; Return[
           MBAnalytica`Private`AssembleSeries[
           MBAnalytica`Private`Finished, MBAnalytica`Private`Eps]]]}], 
    "SubValues" -> None, "DefaultValues" -> None, "NValues" -> None, 
