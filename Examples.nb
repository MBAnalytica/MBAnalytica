Cell[CellGroupData[{

Cell["Evaluation", "Subsection",ExpressionUUID->"789b240a-cc74-49d4-94ab-d1666046ba22"],

Cell["\<\
The two coefficients agree with the expansion at this triangle given in \
Section 6.4 of our paper. CosmoTreeMB warns that one orientation of KIKI and \
one of K23 have the kinematic variable k1/k3 = 5/4 at this triangle; their \
closed forms, continued to this value, agree with the direct numerical \
integration (Section 6.5 of our paper).\
\>", "Text",ExpressionUUID->"1401c700-71f8-4398-9fa4-a2f28b358677"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tree", "[", "blocks_", "]"}], " ", ":=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "[", "\"\<Prefactor\>\"", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"MBEvaluate", "[", 
         RowBox[{
          RowBox[{"b", "[", "\"\<Integrand\>\"", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Subtraction\>\""}]}], "]"}], 
        " ", "/.", " ", 
        RowBox[{"b", "[", "\"\<Variables\>\"", "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "blocks"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "psiKIKI", ",", " ", "psiK23", ",", " ", "psiK12", ",", " ", "psiKK"}], 
    "}"}], " ", "=", " ", 
   RowBox[{"tree", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"KIKI", ",", " ", "K23", ",", " ", "K12", ",", " ", "KK"}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Phi", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"Pi", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "k"}], ")"}]}], "]"}], " ", 
    RowBox[{"Pi", "/", 
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", " ", "nu"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", " ", "psiKIKI"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "/", "Pi"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"Pi", " ", "nu"}], "]"}], " ", "-", " ", "1"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Phi", "[", "k1", "]"}], " ", "psiK23"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"Phi", "[", "k3", "]"}], " ", "psiK12"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "/", "Pi"}], ")"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"Pi", " ", "nu"}], "]"}], " ", 
        RowBox[{"Phi", "[", "k1", "]"}], " ", 
        RowBox[{"Phi", "[", "k3", "]"}], " ", "psiKK"}]}], ")"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"NG", "[", 
    RowBox[{
     RowBox[{"SeriesCoefficient", "[", 
      RowBox[{"A", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", ",", " ", "0", ",", " ", "k"}], "}"}]}], "]"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k1", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"k2", " ", "->", " ", 
        RowBox[{"9", "/", "10"}]}], ",", " ", 
       RowBox[{"k3", " ", "->", " ", 
        RowBox[{"4", "/", "5"}]}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], "Input",Exp\
ressionUUID->"6cbedde8-5267-4e15-8ebd-cecf78763cdc"],

