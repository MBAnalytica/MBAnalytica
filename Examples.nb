   "ObjectType" -> "Symbol", "Usage" -> 
    "CosmoTreeMB[lines, r, nu] gives balanced unit-slope MB integrals, one \
per orientation of the lines, for the de Sitter tree time integral Int prod_v \
dt_v t_v^(r_v - 1) Exp[-x_v t_v] prod_l BesselK[nu_l, y_l t>] BesselI[nu_l, \
y_l t<]. lines lists the vertex pairs {v, w} of a tree on the vertices 1, \
..., Length[r]; nu lists the Bessel orders. Each result is an association: \
\"Integrand\" (the MB, for MBEvaluate), \"Variables\" (the MB variables in \
the energies), \"Prefactor\", \"Later\" (the later vertex of each line), \
\"Push\" and \"Base\"; the integral is the sum over the orientations of \
Prefactor times the integrand's value. Options: \"Energies\" -> {{x1, ...}, \
{y1, ...}}, \"Point\" -> numeric energies (needed to choose positive \
rewritings), \"KLegs\" -> {{v, energy, nu}, ...} (factors BesselK[nu, energy \
t_v] of an in-in block), \"Orientations\", \"VariableName\", and \"LightSplit\
\" -> True (for light fields, the powers (2 + v)^(nu - 1/2) are split by the \
binomial theorem and every term is returned as a separate integral, selected \
by \"Terms\").", "Documentation" -> None, "OwnValues" -> None, "UpValues" -> 
    None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, $CellContext`CosmoTreeMB, {$CellContext`CosmoTreeMB[
         Pattern[MBAnalytica`Private`Edges, 
          Blank[List]], 
         Pattern[MBAnalytica`Private`RV, 
          Blank[List]], 
         Pattern[MBAnalytica`Private`NuL, 
          Blank[List]], 
         OptionsPattern[]] :> 
       Module[{MBAnalytica`Private`NV, MBAnalytica`Private`NL, 
          MBAnalytica`Private`Energies, MBAnalytica`Private`XX, 
          MBAnalytica`Private`YY, MBAnalytica`Private`KLegs, 
          MBAnalytica`Private`Point1, MBAnalytica`Private`XP, 
          MBAnalytica`Private`YP, MBAnalytica`Private`KP, 
          MBAnalytica`Private`Orients, MBAnalytica`Private`Results}, 
         MBAnalytica`Private`NV = Length[MBAnalytica`Private`RV]; 
         MBAnalytica`Private`NL = Length[MBAnalytica`Private`Edges]; If[
           Or[
           MBAnalytica`Private`NL =!= MBAnalytica`Private`NV - 1, 
            Length[MBAnalytica`Private`NuL] =!= MBAnalytica`Private`NL], 
           Message[
             MessageName[$CellContext`CosmoTreeMB, "tree"], 
             MBAnalytica`Private`Edges, MBAnalytica`Private`NV]; 
           Return[$Failed]]; 
         MBAnalytica`Private`Energies = OptionValue["Energies"]; 
         If[
          MBAnalytica`Private`Energies === Automatic, 
           MBAnalytica`Private`Energies = {
             Table[
              Symbol["Global`x" <> ToString[MBAnalytica`Private`V]], {
              MBAnalytica`Private`V, MBAnalytica`Private`NV}], 
             Table[
              Symbol["Global`y" <> ToString[MBAnalytica`Private`L1]], {
              MBAnalytica`Private`L1, MBAnalytica`Private`NL}]}]; {
           MBAnalytica`Private`XX, MBAnalytica`Private`YY} = 
          MBAnalytica`Private`Energies; 
         MBAnalytica`Private`KLegs = OptionValue["KLegs"]; 
         MBAnalytica`Private`Point1 = OptionValue["Point"]; 
         If[MBAnalytica`Private`Point1 === Automatic, 
           MBAnalytica`Private`Point1 = MBAnalytica`Private`Energies]; 
         If[Length[MBAnalytica`Private`Point1] === 2, 
           MBAnalytica`Private`Point1 = Append[MBAnalytica`Private`Point1, 
             Part[MBAnalytica`Private`KLegs, All, 2]]]; {
           MBAnalytica`Private`XP, MBAnalytica`Private`YP, 
            MBAnalytica`Private`KP} = MBAnalytica`Private`Point1; If[
           Not[
            VectorQ[
             Join[MBAnalytica`Private`XP, MBAnalytica`Private`YP], NumericQ]],
            Message[
             MessageName[$CellContext`CosmoTreeMB, "point"]]; 
           Return[$Failed]]; MBAnalytica`Private`KP = MapThread[{
             Part[#, 1], #2, 
             Part[#, 3]}& , {
            MBAnalytica`Private`KLegs, MBAnalytica`Private`KP}]; If[
           Not[
            VectorQ[
             Part[MBAnalytica`Private`KP, All, 2], NumericQ]], Message[
             MessageName[$CellContext`CosmoTreeMB, "point"]]; 
           Return[$Failed]]; 
         MBAnalytica`Private`Orients = OptionValue["Orientations"]; 
         If[MBAnalytica`Private`Orients === All, MBAnalytica`Private`Orients = 
           Tuples[MBAnalytica`Private`Edges]]; 
         If[MBAnalytica`Private`CosmoTreeM[MBAnalytica`Private`Edges, 
             First[MBAnalytica`Private`Orients], 
             MBAnalytica`Private`NV] === $Failed, Message[
             MessageName[$CellContext`CosmoTreeMB, "tree"], 
             MBAnalytica`Private`Edges, MBAnalytica`Private`NV]; 
           Return[$Failed]]; MBAnalytica`Private`Results = Map[
            Function[MBAnalytica`Private`Later, 
             
             Module[{MBAnalytica`Private`Pushes, MBAnalytica`Private`Push, 
               MBAnalytica`Private`Cs, MBAnalytica`Private`Free, 
               MBAnalytica`Private`BaseV, MBAnalytica`Private`Choices, 
               MBAnalytica`Private`Terms1}, 
              MBAnalytica`Private`Pushes = 
               MBAnalytica`Private`CosmoPushChoices[
                MBAnalytica`Private`Edges, MBAnalytica`Private`Later, 
                 MBAnalytica`Private`XP, MBAnalytica`Private`YP, 
                 MBAnalytica`Private`KP, MBAnalytica`Private`XX, 
                 MBAnalytica`Private`YY, MBAnalytica`Private`KLegs]; 
              If[MBAnalytica`Private`Pushes === {}, Message[
                  MessageName[$CellContext`CosmoTreeMB, "nopush"], 
                  MBAnalytica`Private`Later]; Return[$Failed, Module]]; 
              MBAnalytica`Private`Push = Part[MBAnalytica`Private`Pushes, 
                 Min[
                  OptionValue["PushChoice"], 
                  Length[MBAnalytica`Private`Pushes]]]; 
              MBAnalytica`Private`Cs = 
               MBAnalytica`Private`CosmoPushed[
                MBAnalytica`Private`Edges, MBAnalytica`Private`Push, 
                 MBAnalytica`Private`CosmoVertexCoefficients[
                 MBAnalytica`Private`Edges, MBAnalytica`Private`Later, 
                  MBAnalytica`Private`XP, MBAnalytica`Private`YP, 
                  MBAnalytica`Private`KP]]; 
              MBAnalytica`Private`Free = Select[
                 Range[MBAnalytica`Private`NV], And[
                 Part[MBAnalytica`Private`Push, #] === 0, 
                  Not[
                   PossibleZeroQ[
                    Part[
                    MBAnalytica`Private`CosmoPushed[
                    MBAnalytica`Private`Edges, MBAnalytica`Private`Push, 
                    MBAnalytica`Private`CosmoVertexCoefficients[
                    MBAnalytica`Private`Edges, MBAnalytica`Private`Later, 
                    MBAnalytica`Private`XX, MBAnalytica`Private`YY, 
                    MBAnalytica`Private`KLegs]], #]]]]& ]; 
              MBAnalytica`Private`BaseV = First[
                 MaximalBy[
                 MBAnalytica`Private`Free, Part[
                  MBAnalytica`Private`Cs, #]& ]]; 
              MBAnalytica`Private`Choices = Map[
                 Function[MBAnalytica`Private`Mu1, 
                  Module[{
                   MBAnalytica`Private`Nn = 
                    Which[OptionValue["LightSplit"] === True, 
                    MBAnalytica`Private`CosmoIntegerPart[
                    MBAnalytica`Private`Mu1], 
                    And[
                    IntegerQ[
                    OptionValue["LightSplit"]], MBAnalytica`Private`Mu1 =!= 
                    0], 
                    OptionValue["LightSplit"], True, 0]}, 
                   If[MBAnalytica`Private`Nn >= 1, 
                    
                    Table[{MBAnalytica`Private`Mu1 - MBAnalytica`Private`Nn, 
                    MBAnalytica`Private`J1, MBAnalytica`Private`Nn}, {
                    MBAnalytica`Private`J1, 0, MBAnalytica`Private`Nn}], {
                    None}]]], 
                 Join[MBAnalytica`Private`NuL - 1/2, 
                  Map[Part[#, 3] - 1/2& , MBAnalytica`Private`KLegs]]]; 
              MBAnalytica`Private`Terms1 = 
               Tuples[MBAnalytica`Private`Choices]; 
              If[OptionValue["Terms"] =!= All, MBAnalytica`Private`Terms1 = 
                Select[MBAnalytica`Private`Terms1, MemberQ[
                   OptionValue["Terms"], 
                   Map[If[# === None, None, 
                    Part[#, 2]]& , #]]& ]]; 
              Map[MBAnalytica`Private`CosmoOrientation[
                MBAnalytica`Private`Edges, MBAnalytica`Private`Later, 
                 MBAnalytica`Private`Push, MBAnalytica`Private`BaseV, 
                 MBAnalytica`Private`RV, MBAnalytica`Private`NuL, 
                 MBAnalytica`Private`KLegs, MBAnalytica`Private`XX, 
                 MBAnalytica`Private`YY, 
                 OptionValue["VariableName"], #]& , 
                MBAnalytica`Private`Terms1]]], MBAnalytica`Private`Orients]; 
         MBAnalytica`Private`Results = Flatten[MBAnalytica`Private`Results]; 
         MBAnalytica`Private`CosmoCheckUnit[MBAnalytica`Private`Results, 
           Join[
            Thread[MBAnalytica`Private`XX -> MBAnalytica`Private`XP], 
            Thread[MBAnalytica`Private`YY -> MBAnalytica`Private`YP], 
            Thread[
            Part[MBAnalytica`Private`KLegs, All, 2] -> 
             Part[MBAnalytica`Private`KP, All, 2]]]]; 
         Return[MBAnalytica`Private`Results]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     "Energies" -> Automatic, "Point" -> Automatic, "KLegs" -> {}, 
      "Orientations" -> All, "VariableName" -> "u", "LightSplit" -> False, 
      "Terms" -> All, "PushChoice" -> 1}, "Attributes" -> {}, "FullName" -> 
    "MBAnalytica`CosmoTreeMB"|>, False]]], "Output",ExpressionUUID->"1c14dd1a-\
b2dd-4ee8-8f2f-a3be408b1942"]
