     RowBox[{"-", "3"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"u", " ", "->", " ", 
     RowBox[{"1", "/", "3"}]}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
