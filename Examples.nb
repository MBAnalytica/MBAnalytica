Cell["The two leading coefficients are free of MPLs:", "Text",ExpressionUUID->"7dbb666c-8d10-4d3e-a08a-bd1aa8572395"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dexL", "[", 
      RowBox[{"-", "3"}], "]"}], ",", " ", 
     RowBox[{"dexL", "[", 
      RowBox[{"-", "2"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"k1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"k2", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"k3", " ", ">", " ", "0"}]}]}], "]"}]], "Input",ExpressionUUID->\
"5eedaf05-cdc5-4e09-9f87-0d034efbc992"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    FractionBox["k2", 
     RowBox[{
      SuperscriptBox["k1", "2"], " ", 
      SuperscriptBox["k3", "2"]}]]}], ",", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["k1", "2"], "-", 
           SuperscriptBox["k2", "2"], "+", 
           RowBox[{"k1", " ", "k3"}], "+", 
           SuperscriptBox["k3", "2"]}], ")"}]}], "+", 
        RowBox[{"k2", " ", 
         RowBox[{"(", 
          RowBox[{"k1", "+", "k2", "+", "k3"}], ")"}], " ", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"2", " ", "k1"}], 
           RowBox[{"k1", "+", "k2", "+", "k3"}]], "]"}]}], "+", 
        RowBox[{"k2", " ", 
         RowBox[{"(", 
          RowBox[{"k1", "+", "k2", "+", "k3"}], ")"}], " ", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"2", " ", "k3"}], 
           RowBox[{"k1", "+", "k2", "+", "k3"}]], "]"}]}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["k1", "2"], " ", 
        SuperscriptBox["k3", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"k1", "+", "k2", "+", "k3"}], ")"}]}], ")"}]}], ")"}]}]}], 
  "}"}]], "Output",ExpressionUUID->"5637e483-ee41-4482-bf79-54d1139d79c6"]
}, Open  ]],

Cell["\<\
The numbers of distinct MPLs of the coefficients of \[Delta]^-3, ..., \
\[Delta]^1, and their values at the triangle, those of Section 6.4 of our \
paper:\
\>", "Text",ExpressionUUID->"55dd9f7b-1738-4652-b57c-accdd07f715f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"#", ",", " ", "_PolyLogTools`G", ",", " ", "Infinity"}], 
         "]"}], "]"}], "]"}], " ", "&"}], ",", " ", "dexL"}], "]"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"NG", "[", 
      RowBox[{
       RowBox[{"dexL", "[", "k", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"k1", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"k2", " ", "->", " ", 
          RowBox[{"9", "/", "10"}]}], ",", " ", 
         RowBox[{"k3", " ", "->", " ", 
          RowBox[{"4", "/", "5"}]}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"-", "3"}], ",", " ", "1"}], "}"}]}], "]"}]}], "}"}]], "Input",\
ExpressionUUID->"67311449-813f-438d-8e79-412283e1ab6f"],

