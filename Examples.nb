   "]"}]}]], "Input",ExpressionUUID->"84e89ac3-41a9-4bdf-9c3a-810e7ac2bf8e"],

Cell[BoxData[
 RowBox[{"1", "-", 
  RowBox[{"\[Epsilon]", " ", 
   RowBox[{"Log", "[", "y", "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[Epsilon]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[Pi]", "2"], "6"], "+", 
     RowBox[{"G", "[", 
      RowBox[{"0", ",", "1", ",", "y"}], "]"}], "-", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "y"}], "]"}], " ", 
      RowBox[{"Log", "[", "y", "]"}]}], "+", 
     SuperscriptBox[
      RowBox[{"Log", "[", "y", "]"}], "2"]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[Epsilon]", "3"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"G", "[", 
       RowBox[{"0", ",", "0", ",", 
        FractionBox["1", "y"], ",", "1"}], "]"}]}], "+", 
