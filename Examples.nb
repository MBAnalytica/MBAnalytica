         RowBox[{"1", ",", " ", 
          RowBox[{"4", "/", "5"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K23", " ", "=", " ", 
