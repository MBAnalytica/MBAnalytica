Cell[CellGroupData[{

Cell["3-Denominator Massless Angular Integral", "Section",ExpressionUUID->"45101758-098e-4d87-8268-ee5af2e30160"],

Cell["\<\
This example is the angular integral of three massless denominators, \
discussed in Section 6.2 of our paper, with all powers j_k = 1. Every \
variable v_kl is a kinematic variable in 0 < v_kl < 1, and the integral has \
one fold per variable.\
\>", "Text",ExpressionUUID->"991db175-cdb2-46b7-ae6b-bf7d3f8225b4"],

Cell[CellGroupData[{

Cell["Configuration", "Subsection",ExpressionUUID->"cd35ea17-120c-404f-a3a4-070d3a32d9e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"I111", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", "^", 
