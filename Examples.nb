Notebook[{

Cell[CellGroupData[{
Cell["\<\
Analytic Evaluation of Mellin\[Dash]Barnes Integrals using MBAnalytica\
\>", "Title",ExpressionUUID->"700af00f-5d53-4fba-8361-1886ab22b768"],

Cell[TextData[{
 StyleBox["- Taushif Ahmed",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Sumit Banik",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Syed Mehedi Hasan",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Andreas Rapakoulias",
  FontWeight->"Bold"]
}], "Author",ExpressionUUID->"8c25f254-5a15-4317-8f69-d4732b4e327a"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Loading Package",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Chapter",ExpressionUUID->"307687d8-\
756e-4bf0-a9ae-2a50b8848273"],

Cell[CellGroupData[{

Cell[BoxData["$Version"], "Input",ExpressionUUID->"aed6d869-5ec3-4b09-9f22-deeb7980038d"],

Cell[BoxData["\<\"15.0.0 for Linux x86 (64-bit) (May 19, 2026)\"\>"], "Output",ExpressionUUID->"a0667002-8df3-4175-aa53-2c7f3b4a26a1"]
