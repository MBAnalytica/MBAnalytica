      RowBox[{
       RowBox[{"-", "1"}], " ", "+", " ", 
       RowBox[{"2", " ", "\[Epsilon]"}]}], ")"}]}], " ", 
    RowBox[{"Pi", "^", "\[Epsilon]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "-", " ", "\[Epsilon]"}], "]"}]}], " ", 
